<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_bg }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- endif -%}
  <title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {%- liquid
    assign f_head = settings.font_heading
    assign f_body = settings.font_body
    assign f_head_bold = f_head | font_modify: 'weight', settings.font_heading_weight
    assign f_body_bold = f_body | font_modify: 'weight', 'bold'
    assign f_body_ital = f_body | font_modify: 'style', 'italic'
  -%}
  {%- comment -%}
    font_face returns a bare @font-face rule, not a tag - it has to sit inside
    a style block or the browser prints it as text at the top of the page.
  {%- endcomment -%}
  <style>
    {{ f_head | font_face: font_display: 'swap' }}
    {{ f_head_bold | font_face: font_display: 'swap' }}
    {{ f_body | font_face: font_display: 'swap' }}
    {{ f_body_bold | font_face: font_display: 'swap' }}
    {{ f_body_ital | font_face: font_display: 'swap' }}
  </style>

  {{ 'ryvt.css' | asset_url | stylesheet_tag }}

  {%- comment -%}
    Every theme setting arrives as a CSS custom property, so the stylesheet
    never has to know what a merchant chose - it just reads the variable, and
    the theme editor updates live.
  {%- endcomment -%}
  <style>
    :root{
      /* the site's own tokens, re-declared from Theme settings so anything
         chosen in the editor overrides the design's defaults */
      --paper:{{ settings.color_bg }};
      --concrete:{{ settings.color_bg_alt }};
      --plate:{{ settings.color_tile }};
      --ink:{{ settings.color_text }};
      --muted:{{ settings.color_muted }};
      --line:{{ settings.color_line }};
      --stock:{{ settings.color_low }};
      --mx:{{ settings.page_width }}px;

      /* the not-yet-ported sections read these older names; both sets point
         at the same settings so the editor drives the whole site during the
         transition */
      --bg:{{ settings.color_bg }};
      --bg2:{{ settings.color_bg_alt }};
      --tile:{{ settings.color_tile }};
      --ok:{{ settings.color_stock }};
      --page:{{ settings.page_width }}px;

      --sans:{{ f_body.family }}, {{ f_body.fallback_families }};
      --display:{{ f_head.family }}, {{ f_head.fallback_families }};
      --fw-head:{{ settings.font_heading_weight }};
      --fs-scale:{{ settings.font_heading_scale | divided_by: 100.0 }};
      --tr-head:{{ settings.font_heading_tracking | divided_by: 100.0 }}em;
      --case-head:{{ settings.font_heading_case }};
      --fs-body:{{ settings.font_body_size }}px;
      --lh-body:{{ settings.font_body_line | divided_by: 100.0 }};
      --fs-label:{{ settings.font_label_size }}px;
      --tr-label:{{ settings.font_label_tracking | divided_by: 100.0 }}em;
      --case-label:{% if settings.font_label_upper %}uppercase{% else %}none{% endif %};

      --card-ratio:{{ settings.card_ratio }};
      --card-fit:{{ settings.card_fit }};
      --card-radius:{{ settings.card_radius }}px;
      --card-name-size:{{ settings.card_name_size }}px;
      --card-name-case:{{ settings.card_name_case }};
      --card-name-color:{{ settings.card_name_color }};
      --card-price-color:{{ settings.card_price_color }};

      --cols:{{ settings.grid_columns }};
      --cols-m:{{ settings.grid_columns_mobile }};
      --gap:{{ settings.grid_gap }}px;
      --sec:{{ settings.section_space }}px;

      --btn-bg:{{ settings.color_btn_bg }};
      --btn-tx:{{ settings.color_btn_text }};
      --btn-bg-h:{{ settings.color_btn_bg_hover }};
      --btn-tx-h:{{ settings.color_btn_text_hover }};
      --ft-bg:{{ settings.color_footer_bg }};
      --ft-tx:{{ settings.color_footer_text }};
    }
    {%- unless settings.motion_reveal %}[data-rise]{opacity:1!important;transform:none!important}{% endunless -%}
    {%- unless settings.motion_hover_zoom %}.card-media img{transform:none!important}{% endunless -%}
  </style>

  {{ content_for_header }}
</head>
<body class="template-{{ template.name }} cart-{{ settings.cart_type }}"
      data-motion-counters="{{ settings.motion_counters }}"
      data-ship-threshold="{{ settings.ship_threshold }}">
  <a href="#main" style="position:absolute;left:-9999px">Skip to content</a>
  {% sections 'header-group' %}
  <main id="main" role="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% section 'site-popups' %}
  {{ 'ryvt.js' | asset_url | script_tag }}
</body>
</html>
