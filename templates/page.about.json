          "type": "row",
          "settings": {
            "year": "2019",
            "title": "First cut",
            "body": "One tee, sewn in a rented studio on the east side. Sold out to friends before it had a name."
          }
        },
        "r2": {
          "type": "row",
          "settings": {
            "year": "2021",
            "title": "The Renaissance Tee",
            "body": "The cut that made the label. Still the piece most people buy twice."
          }
        },
        "r3": {
          "type": "row",
          "settings": {
            "year": "2023",
            "title": "Training range",
            "body": "Tanks and bottoms added \u2014 tested by coaches across the metro before a single unit shipped."
          }
        },
        "r4": {
          "type": "row",
          "settings": {
            "year": "Now",
            "title": "Same city, same crew",
            "body": "Cut and finished within twenty miles of where we train. That does not change."
          }
        }
      },
