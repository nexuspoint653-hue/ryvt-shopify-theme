{
  "sections": {
    "band_open": {
      "type": "media-band",
      "settings": {
        "band_height": "full",
        "parallax": true,
        "overlay_tag": "Metro Detroit, Michigan",
        "overlay_title": "Rebirth",
        "overlay_sub": "A city that got written off and kept working anyway. We make kit for the people still putting in the hours.",
        "overlay_pos": "bl",
        "scrim": true,
        "scheme": "light"
      }
    },
    "who": {
      "type": "statement",
      "blocks": {
        "p1": {
          "type": "para",
          "settings": {
            "body": "<p>RYVT was built in Metro Detroit for people who train hard and then keep the same clothes on for the rest of the day. No logos shouting. No seasonal noise. A short, deliberate range instead of a long, forgettable one.</p>"
          }
        },
        "p2": {
          "type": "para",
          "settings": {
            "body": "<p>We are a small crew \u2014 pattern cutters, athletes, a couple of stubborn perfectionists. Every piece earns its place or it does not ship.</p>"
          }
        }
      },
      "block_order": [
        "p1",
        "p2"
      ],
      "settings": {
        "marker": "01",
        "eyebrow": "The City",
        "heading": "Built Where",
        "heading_accent": "It's Hard",
        "scale": "l",
        "align": "left",
        "size": "lg",
        "grain": false,
        "scheme": "light"
      }
    },
    "band_2": {
      "type": "media-band",
      "settings": {
        "band_height": "tall",
        "parallax": true,
        "scheme": "light"
      }
    },
    "cut": {
      "type": "statement",
      "blocks": {
        "p1": {
          "type": "para",
          "settings": {
            "body": "<p>Performance kit does not have to shout. Clean lines, fabric that behaves, fit that holds its shape after fifty washes. We design in the city, test in the city, and we do not release anything we would not train in ourselves.</p>"
          }
        },
        "p2": {
          "type": "para",
          "settings": {
            "body": "<p>Fewer, better pieces \u2014 cut properly, priced honestly, made to be worn until they wear out.</p>"
          }
        }
      },
      "block_order": [
        "p1",
        "p2"
      ],
      "settings": {
        "marker": "02",
        "eyebrow": "The Cut",
        "heading": "Nothing",
        "heading_accent": "Wasted",
        "scale": "l",
        "align": "left",
        "size": "lg",
        "grain": false,
        "link_text": "Shop the range",
        "link": "/collections/all",
        "scheme": "light",
        "cta_solid": true
      }
    },
    "record": {
