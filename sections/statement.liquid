{% render 'section-style', s: section %}
<section class="mf mf--{{ section.settings.size }}{% if section.settings.align == 'center' %} mf--center{% endif %}{% if section.settings.grain %} grain{% endif %}">
  <div class="mf-in">
    {%- if section.settings.marker != blank or section.settings.eyebrow != blank -%}
      <div class="mf-mark" data-rv>
        {%- if section.settings.marker != blank -%}<span class="num">{{ section.settings.marker }}</span>{%- endif -%}
        {%- if section.settings.eyebrow != blank -%}<span class="tag">{{ section.settings.eyebrow }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="mf-grid">
      <div class="mf-h" data-rv>
        {%- if section.settings.heading != blank -%}
          <h2 class="dsp dsp-{{ section.settings.scale }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.heading_accent != blank -%}
          <h2 class="dsp dsp-{{ section.settings.scale }}"><em>{{ section.settings.heading_accent }}</em></h2>
        {%- endif -%}
      </div>
      <div class="mf-body">
        {%- for block in section.blocks -%}
          {%- if block.settings.body != blank -%}
            <div class="copy" data-rv {{ block.shopify_attributes }}>{{ block.settings.body }}</div>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.link_text != blank -%}
          <div class="mf-cta" data-rv>
            <a class="ibtn{% if section.settings.cta_solid %} ibtn-cu{% endif %}" href="{{ section.settings.link }}">{{ section.settings.link_text }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Manifesto",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Heavy statement block — numbered marker, oversized display heading, copy alongside." },
    { "type": "text", "id": "marker", "label": "Marker", "info": "Optional \u2014 leave blank for no number" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built where" },
    { "type": "text", "id": "heading_accent", "label": "Second line", "default": "it's hard" },
    { "type": "select", "id": "scale", "label": "Heading size", "default": "l",
      "options": [
        { "value": "xl", "label": "Enormous" },
        { "value": "l", "label": "Large" },
        { "value": "m", "label": "Medium" },
        { "value": "s", "label": "Small" }
      ]},
    { "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Centred" }]},
    { "type": "select", "id": "size", "label": "Breathing room", "default": "lg",
      "options": [
        { "value": "sm", "label": "Tight" },
        { "value": "md", "label": "Normal" },
        { "value": "lg", "label": "Generous" },
        { "value": "xl", "label": "Cinematic" }
      ]},
    { "type": "checkbox", "id": "grain", "label": "Subtle grain overlay", "default": false },
    { "type": "text", "id": "link_text", "label": "Button" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "checkbox", "id": "cta_solid", "label": "Filled button", "default": false },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "light",
      "options": [{"value":"light","label":"White"},{"value":"alt","label":"Off-white"},
                  {"value":"sand","label":"Sand"},
                  {"value":"dark","label":"Dark"},{"value":"custom","label":"Custom"}] },
    { "type": "color", "id": "bg_custom", "label": "Custom background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_custom", "label": "Custom text", "default": "#111111" },
    { "type": "range", "id": "pad_top", "label": "Extra top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Extra bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "para", "name": "Paragraph", "settings": [
      { "type": "richtext", "id": "body", "label": "Text",
        "default": "<p>RYVT was built in Metro Detroit for people who train hard and then keep the same clothes on for the rest of the day. No logos shouting. No seasonal noise.</p>" }
    ]}
  ],
  "presets": [{ "name": "Manifesto", "blocks": [{ "type": "para" }] }]
}
{% endschema %}
