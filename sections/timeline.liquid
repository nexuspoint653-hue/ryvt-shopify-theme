{% render 'section-style', s: section %}
<section class="tl{% if section.settings.grain %} grain{% endif %}">
  <div class="tl-in">
    <div class="tl-head" data-rv>
      {%- if section.settings.marker != blank -%}<span class="num">{{ section.settings.marker }}</span>{%- endif -%}
      {%- if section.settings.eyebrow != blank -%}<span class="tag">{{ section.settings.eyebrow }}</span>{%- endif -%}
    </div>
    {%- if section.settings.heading != blank -%}
      <h2 class="dsp dsp-l" data-rv style="margin-top:clamp(20px,2.6vw,40px)">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="tl-rows">
      {%- for block in section.blocks -%}
        <div class="tl-r" data-rv {{ block.shopify_attributes }}>
          <div class="tl-y">{{ block.settings.year }}</div>
          <div class="tl-t">{{ block.settings.title }}</div>
          <div class="tl-d">{{ block.settings.body }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "marker", "label": "Marker", "default": "03" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Record" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How We Got Here" },
    { "type": "checkbox", "id": "grain", "label": "Subtle grain overlay", "default": false },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "alt",
      "options": [{"value":"light","label":"White"},{"value":"alt","label":"Off-white"},
                  {"value":"sand","label":"Sand"},
                  {"value":"dark","label":"Dark"},{"value":"custom","label":"Custom"}] },
    { "type": "color", "id": "bg_custom", "label": "Custom background", "default": "#F7F7F6" },
    { "type": "color", "id": "text_custom", "label": "Custom text", "default": "#111111" },
    { "type": "range", "id": "pad_top", "label": "Extra top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Extra bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "row", "name": "Milestone", "settings": [
      { "type": "text", "id": "year", "label": "Year", "default": "2019" },
      { "type": "text", "id": "title", "label": "Title", "default": "First cut" },
      { "type": "text", "id": "body", "label": "Text", "default": "A single tee, sewn in a rented studio on the east side." }
    ]}
  ],
  "presets": [{ "name": "Timeline", "blocks": [{"type":"row"},{"type":"row"},{"type":"row"}] }]
}
{% endschema %}
