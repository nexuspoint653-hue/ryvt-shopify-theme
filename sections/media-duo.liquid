{% render 'section-style', s: section %}
<section class="duo" data-duo>
  {%- if section.settings.eyebrow != blank or section.blocks.size > 2 -%}
    <div class="duo-bar">
      <div class="mini">{{ section.settings.eyebrow }}</div>
      {%- if section.blocks.size > 2 -%}
        <div class="duo-nav">
          <button type="button" class="duo-b" data-duo-prev aria-label="Previous">&#8592;</button>
          <button type="button" class="duo-b" data-duo-next aria-label="Next">&#8594;</button>
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="duo-track" data-duo-track>
    {%- for block in section.blocks -%}
      {%- assign url = block.settings.link | default: '#' -%}
      <a class="duo-c" href="{{ url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.video != blank -%}
          <video class="duo-m" autoplay muted loop playsinline src="{{ block.settings.video }}"
            {% if block.settings.image %}poster="{{ block.settings.image | image_url: width: 1200 }}"{% endif %}></video>
        {%- elsif block.settings.image != blank -%}
          <img class="duo-m" src="{{ block.settings.image | image_url: width: 1600 }}"
            srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1600 }} 1600w"
            sizes="50vw" alt="{{ block.settings.image.alt | escape }}" loading="lazy">
        {%- else -%}
          <div class="duo-m duo-ph"></div>
        {%- endif -%}
        <div class="duo-scrim"></div>
        <div class="duo-txt">
          {%- if block.settings.title != blank -%}<h3 class="duo-t">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.caption != blank -%}<p class="duo-cap">{{ block.settings.caption }}</p>{%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>
<script>
(function(){
  document.querySelectorAll('[data-duo]').forEach(function(root){
    var track = root.querySelector('[data-duo-track]');
    var prev  = root.querySelector('[data-duo-prev]');
    var next  = root.querySelector('[data-duo-next]');
    if(!track || !prev || !next) return;
    function step(){ var c = track.querySelector('.duo-c'); return c ? c.getBoundingClientRect().width : track.clientWidth/2; }
    next.addEventListener('click', function(){ track.scrollBy({left: step(), behavior:'smooth'}); });
    prev.addEventListener('click', function(){ track.scrollBy({left: -step(), behavior:'smooth'}); });
    function sync(){
      var max = track.scrollWidth - track.clientWidth - 2;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max;
    }
    track.addEventListener('scroll', sync, {passive:true});
    window.addEventListener('resize', sync);
    sync();
  });
})();
</script>
{% schema %}
{
  "name": "Media duo",
  "tag": "section",
  "settings": [
    { "type": "paragraph", "content": "Two full-bleed tiles side by side. Add more than two blocks and arrows appear to slide through them." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "On Brand" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "light",
      "options": [{"value":"light","label":"White"},{"value":"alt","label":"Off-white"},
                  {"value":"sand","label":"Sand"},{"value":"dark","label":"Dark"},{"value":"custom","label":"Custom"}] },
    { "type": "color", "id": "bg_custom", "label": "Custom background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_custom", "label": "Custom text", "default": "#111111" }
  ],
  "blocks": [
    { "type": "tile", "name": "Tile", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "video", "label": "Video file URL" },
      { "type": "text", "id": "title", "label": "Title", "default": "RYVT × Detroit" },
      { "type": "text", "id": "caption", "label": "Caption", "default": "Made and tested where we live." },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Media duo", "blocks": [{ "type": "tile" }, { "type": "tile" }] }]
}
{% endschema %}
