{%- comment -%} Search results — the shop grid, with the query in the masthead. {%- endcomment -%}
<div class="wrap shop-hd">
  <h1>{% if search.terms != blank %}Results{% else %}Search{% endif %}</h1>
  {%- if search.performed -%}
    <p>{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}
       for &ldquo;{{ search.terms | escape }}&rdquo;.</p>
  {%- else -%}
    <p>{{ section.settings.body }}</p>
  {%- endif -%}
</div>

<div class="wrap shop-bar">
  <span class="shop-tally">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %}</span>
  <form action="{{ routes.search_url }}" method="get" role="search" class="srch-inline">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search again" aria-label="Search">
    <button type="submit">Go</button>
  </form>
</div>

<section class="sec wrap" style="padding-top:26px">
  {%- paginate search.results by 24 -%}
    <div class="grid indexed"{% if settings.card_swatches_hover %} data-swatch-hover{% endif %}>
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item, index: forloop.index %}
        {%- else -%}
          <a class="card card--doc" href="{{ item.url }}">
            <div class="card-info" data-align="left">
              <span class="card-name">{{ item.title }}</span>
            </div>
          </a>
        {%- endif -%}
      {%- else -%}
        <div class="empty">
          <h3 class="h3">Nothing found</h3>
          <p>Try a different word, or <a href="{{ routes.all_products_collection_url }}">see everything</a>.</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<nav class="pager">{{ paginate | default_pagination }}</nav>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "Search",
  "settings": [
    { "type": "textarea", "id": "body", "label": "Text before a search",
      "default": "Look for a style, a fabric or a colour." }
  ]
}
{% endschema %}
