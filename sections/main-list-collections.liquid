{%- comment -%} All collections — the category tiles. {%- endcomment -%}
<div class="wrap shop-hd">
  <h1>{{ section.settings.heading }}</h1>
  {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
</div>
<section class="sec wrap">
  <div class="cats">
    {%- for c in collections -%}
      <a class="cat" href="{{ c.url }}">
        <span class="fig">
          {%- if c.featured_image -%}
            <img src="{{ c.featured_image | image_url: width: 800 }}" alt="{{ c.title | escape }}"
                 width="800" height="1000" loading="lazy">
          {%- else -%}<span class="ph{% cycle '', ' alt', ' dark' %}"></span>{%- endif -%}
        </span>
        <span class="cat-lab">
          <span><b>{{ c.title }}</b><span>{{ c.all_products_count }} styles</span></span>
          <span class="cat-go">&rarr;</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Collections",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "textarea", "id": "body", "label": "Body" }
  ]
}
{% endschema %}
