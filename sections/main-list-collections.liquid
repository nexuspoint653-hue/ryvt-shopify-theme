{% render 'section-style', s: section %}
<div class="wrap" style="padding-block:clamp(26px,3vw,42px)"><h1 class="h2">Shop</h1></div>
<div class="grid stag in" data-row data-max="{{ settings.grid_columns }}"{% if settings.card_swatches_hover %} data-swatch-hover{% endif %}>
  {%- for c in collections -%}
    <a class="pc" href="{{ c.url }}">
      <div class="pc-m">
        {%- if c.featured_image -%}<img class="main" src="{{ c.featured_image | image_url: width: 900 }}" alt="" loading="lazy">
        {%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
      </div>
      <div class="pc-i"><div class="pc-top"><span class="pc-n">{{ c.title }}</span></div>
        {%- assign ccount = c.products_count | plus: 0 -%}
        {%- if ccount > 0 -%}<div class="pc-c">{{ ccount }} item{% unless ccount == 1 %}s{% endunless %}</div>{%- endif -%}</div>
    </a>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Collections list",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "alt",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Extra top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "header",
      "content": "Section type"
    },
    {
      "type": "paragraph",
      "content": "Leave these alone and the section follows the site's typography. Set them only when this one section needs to differ."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font for this section",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    }
  ]
}
{% endschema %}
