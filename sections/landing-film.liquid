{% render 'section-style', s: section %}
{%- comment -%}
  Landing film - one full-bleed screen: video background, centred wordmark and
  menu, promotional header, live city clock, now-playing pill, a drops pill and
  a shipping-promise link.

  The film comes from the first of these that is set: the Video setting, then a
  YouTube or Vimeo URL, then a file in the theme's assets folder. The poster
  image covers the moment before the first frame paints, and any device that
  refuses to autoplay.
{%- endcomment -%}

{%- liquid
  assign webm_src = ''
  if section.settings.video_asset != blank
    assign va_stem = section.settings.video_asset | split: '.' | first
    assign webm_src = va_stem | append: '.webm'
  endif
  assign promo_lines = section.blocks | where: 'type', 'promo'
-%}

<style>
/* ==========================================================
   Full-bleed film landing. One screen, no scroll: the film
   carries the mood, the type sits on top of it, and every
   corner earns its keep.
   ========================================================== */
#lf-{{ section.id }}{
  --ink:#0B0B0C;
  --white:#FFFFFF;
  --dim:rgba(255,255,255,.62);
  --faint:rgba(255,255,255,.34);
  --hair:rgba(255,255,255,.18);
  --pill:rgba(17,17,19,.62);
  --brass:#B08442;
  --e:cubic-bezier(.22,.61,.36,1);
  --sans:Inter,-apple-system,'Segoe UI',Helvetica,Arial,sans-serif;
  --mono:'JetBrains Mono',ui-monospace,SFMono-Regular,Menlo,monospace;
  color-scheme:dark;
}
#lf-{{ section.id }} *{box-sizing:border-box}
#lf-{{ section.id }}{
  position:relative;min-height:100svh;background:var(--ink);color:var(--white);
  font-family:var(--sans);font-size:14px;line-height:1.5;-webkit-font-smoothing:antialiased;
}
body.lf-locked{overflow:hidden}
#lf-{{ section.id }} a{color:inherit;text-decoration:none}
#lf-{{ section.id }} button{font:inherit;color:inherit;background:none;border:0;cursor:none;padding:0}
#lf-{{ section.id }} :focus-visible{outline:1px solid rgba(255,255,255,.7);outline-offset:4px}

/* ---------- the film ---------- */
.stage{position:fixed;inset:0;overflow:hidden;background:#08080A center/cover no-repeat}
.stage video,.stage img.fallback{
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  transform:scale(1.04);opacity:0;transition:opacity 1.4s var(--e)
}
.stage.ready video{opacity:1}
/* two passes over the footage: a top-to-bottom fall-off and a soft vignette,
   so white type holds no matter what the film is doing underneath */
.stage::after{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:
    linear-gradient(180deg,rgba(8,8,10,.62) 0,rgba(8,8,10,.12) 26%,rgba(8,8,10,.14) 62%,rgba(8,8,10,.78) 100%),
    radial-gradient(120% 90% at 50% 45%,transparent 38%,rgba(8,8,10,.55) 100%)
}
.grain{
  position:fixed;inset:-120%;pointer-events:none;z-index:2;opacity:.055;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3'/></filter><rect width='160' height='160' filter='url(%23n)'/></svg>");
  animation:grain 7s steps(6) infinite
}
@keyframes grain{
  0%{transform:translate(0,0)} 20%{transform:translate(-4%,3%)} 40%{transform:translate(3%,-5%)}
  60%{transform:translate(-3%,-3%)} 80%{transform:translate(4%,4%)} 100%{transform:translate(0,0)}
}

/* ---------- centre column ---------- */
.core{
  position:fixed;inset:0;z-index:4;display:grid;place-items:center;
  padding:24px;text-align:center
}
.core-in{display:flex;flex-direction:column;align-items:center;gap:34px}
.mark{
  display:flex;align-items:center;gap:14px;
  opacity:0;transform:translateY(10px);filter:blur(6px);
  animation:rise .9s var(--e) .25s forwards
}
.mark .orb{
  width:22px;height:22px;border-radius:50%;border:1px solid rgba(255,255,255,.5);
  display:grid;place-items:center;flex:0 0 auto
}
.mark .orb::after{content:"";width:3px;height:3px;border-radius:50%;background:#fff;
  animation:pulse 2.6s var(--e) infinite}
@keyframes pulse{0%,100%{opacity:.35;transform:scale(1)}50%{opacity:1;transform:scale(1.5)}}
.mark .logo{height:clamp(26px,3.4vw,40px);width:auto;display:block}
.mark .word{
  font-size:clamp(30px,4.6vw,46px);font-weight:700;letter-spacing:-.035em;line-height:1;
  display:inline-flex;align-items:flex-start
}
.mark .word sup{font-size:.3em;font-weight:500;letter-spacing:0;margin-top:.35em;margin-left:.12em;opacity:.8}

.menu{display:flex;flex-direction:column;align-items:center;gap:2px}
.menu a{
  position:relative;font-size:15px;font-weight:600;letter-spacing:-.005em;
  padding:7px 18px;color:var(--dim);
  opacity:0;transform:translateY(8px);
  animation:rise .7s var(--e) forwards;transition:color .3s var(--e)
}
.menu a:nth-child(1){animation-delay:.42s}
.menu a:nth-child(2){animation-delay:.5s}
.menu a:nth-child(3){animation-delay:.58s}
.menu a:nth-child(4){animation-delay:.66s}
.menu a:nth-child(5){animation-delay:.74s}
.menu a::before{
  content:"";position:absolute;left:50%;right:50%;bottom:3px;height:1px;
  background:rgba(255,255,255,.75);transition:left .38s var(--e),right .38s var(--e)
}
.menu a:hover{color:#fff}
.menu a:hover::before{left:18px;right:18px}
@keyframes rise{to{opacity:1;transform:none;filter:blur(0)}}

/* ---------- corners ---------- */
.hud{position:fixed;z-index:5;opacity:0;animation:rise .8s var(--e) .9s forwards}
.hud-bl{left:22px;bottom:22px}
.hud-br{right:22px;bottom:22px;display:flex;flex-direction:column;align-items:flex-end;gap:10px}
.hud-bc{left:0;right:0;bottom:24px;text-align:center;pointer-events:none}
.clock{font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;color:var(--faint)}
.clock b{color:rgba(255,255,255,.82);font-weight:500;margin-right:8px;letter-spacing:.18em}
.clock span{font-variant-numeric:tabular-nums}

/* the now-playing card */
.np{
  display:flex;align-items:center;gap:14px;padding:10px 16px 10px 10px;border-radius:999px;
  background:var(--pill);border:1px solid var(--hair);backdrop-filter:blur(16px) saturate(1.3);
  -webkit-backdrop-filter:blur(16px) saturate(1.3);transition:transform .4s var(--e)
}
.np:hover{transform:translateY(-2px)}
.np-art{
  width:52px;height:52px;border-radius:50%;flex:0 0 auto;position:relative;
  background:conic-gradient(from 210deg,#8E86F5,#5B54B8 45%,#2A2740 75%,#8E86F5);
  animation:spin 9s linear infinite;animation-play-state:paused
}
.np.playing .np-art{animation-play-state:running}
.np-art::after{content:"";position:absolute;inset:44%;border-radius:50%;background:#0B0B0C}
@keyframes spin{to{transform:rotate(360deg)}}
.np-t{display:flex;flex-direction:column;gap:1px;min-width:0}
.np-t b{font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:600}
.np-t span{font-size:11.5px;color:var(--faint)}
.np-chip{
  align-self:flex-start;margin-top:4px;font-size:9px;letter-spacing:.12em;text-transform:uppercase;
  border:1px solid var(--hair);border-radius:4px;padding:2px 5px;color:var(--faint)
}
.np-ctl{display:flex;align-items:center;gap:10px;margin-left:6px}
.np-ctl button{width:26px;height:26px;display:grid;place-items:center;color:var(--dim);
  transition:color .25s var(--e),transform .25s var(--e)}
.np-ctl button:hover{color:#fff;transform:scale(1.1)}
.np-play{border:1px solid rgba(255,255,255,.5);border-radius:50%}

/* the drops pill + the shipping promise */
.buy{
  display:flex;align-items:center;gap:14px;padding:10px 18px 10px 10px;border-radius:17px;
  background:var(--pill);border:1px solid var(--hair);backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);transition:transform .4s var(--e),border-color .3s var(--e)
}
.buy:hover{transform:translateY(-2px);border-color:var(--brass)}
.buy-m{width:62px;height:62px;border-radius:12px;flex:0 0 auto;object-fit:cover;display:block;
  border:1px solid rgba(255,255,255,.12)}
.buy-t{display:flex;flex-direction:column;line-height:1.4}
.buy-t b{font-size:13.5px;font-weight:600;letter-spacing:-.005em}
.buy-t span{font-size:11.5px;color:var(--faint)}
.buy-t span i{font-style:normal;color:#fff;margin-left:6px}
.buy-go{margin-left:4px;font-size:14px;color:var(--faint);
  transform:translateX(-4px);opacity:0;transition:.35s var(--e)}
.buy:hover .buy-go{opacity:1;transform:none;color:#fff}
.ship{
  display:inline-flex;align-items:center;gap:9px;padding:10px 15px;border-radius:11px;
  background:rgba(18,18,20,.62);border:1px solid var(--hair);backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);font-size:11.5px;letter-spacing:.02em;color:var(--dim);
  transition:color .3s var(--e),border-color .3s var(--e),transform .4s var(--e)
}
.ship b{color:#fff;font-weight:600;margin-left:2px}
.ship:hover{color:#fff;border-color:var(--brass);transform:translateY(-2px)}
.ship svg{width:15px;height:15px;flex:0 0 auto;opacity:.8}

/* ---------- promotional header ---------- */
.promo{
  position:fixed;top:0;left:0;right:0;z-index:8;display:flex;justify-content:center;
  padding:14px 14px 0;pointer-events:none;
  opacity:0;transform:translateY(-10px);animation:rise .8s var(--e) .55s forwards
}
.promo.gone{animation:none;opacity:0;transform:translateY(-14px);transition:.4s var(--e)}
.promo-in{
  pointer-events:auto;display:flex;align-items:center;gap:14px;
  padding:9px 10px 9px 16px;border-radius:999px;max-width:min(92vw,720px);
  background:rgba(14,14,16,.62);border:1px solid var(--hair);
  backdrop-filter:blur(18px) saturate(1.3);-webkit-backdrop-filter:blur(18px) saturate(1.3)
}
.promo-dot{width:6px;height:6px;border-radius:50%;background:#fff;flex:0 0 auto;
  animation:pulse 2.4s var(--e) infinite}
/* the lines stack in one grid cell, so the longest still sets the width */
.promo-track{display:grid;height:17px;flex:0 1 auto;overflow:hidden;min-width:0}
.promo-msg{
  grid-area:1/1;font-size:12px;letter-spacing:.01em;color:rgba(255,255,255,.86);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  opacity:0;transform:translateY(9px);transition:opacity .5s var(--e),transform .5s var(--e)
}
.promo-msg.on{opacity:1;transform:none}
.promo-cta{
  flex:0 0 auto;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;font-weight:600;
  padding:7px 13px;border-radius:999px;background:#fff;color:#0B0B0C;
  transition:opacity .3s var(--e)
}
.promo-cta:hover{opacity:1;background:var(--brass);color:#0B0B0C}
.promo-x{flex:0 0 auto;width:26px;height:26px;display:grid;place-items:center;color:var(--faint);
  border-radius:50%;transition:color .3s var(--e),background .3s var(--e)}
.promo-x:hover{color:#fff;background:rgba(255,255,255,.1)}

/* ---------- the cursor ---------- */
@media (hover:hover) and (pointer:fine){
  body.lf-cursor,body.lf-cursor a,body.lf-cursor button{cursor:none}
  .cur,.cur-r{position:fixed;top:0;left:0;z-index:60;pointer-events:none;border-radius:50%;
    mix-blend-mode:difference}
  .cur{width:6px;height:6px;background:#fff;margin:-3px 0 0 -3px;
    transition:opacity .3s var(--e),transform .18s var(--e)}
  .cur-r{width:34px;height:34px;border:1px solid rgba(255,255,255,.65);margin:-17px 0 0 -17px;
    transition:width .32s var(--e),height .32s var(--e),margin .32s var(--e),
      opacity .3s var(--e),background .32s var(--e)}
  body.lf-hot .cur-r{width:62px;height:62px;margin:-31px 0 0 -31px;background:rgba(255,255,255,.12)}
  body.lf-hot .cur{transform:scale(.4)}
  body.lf-press .cur-r{width:26px;height:26px;margin:-13px 0 0 -13px}
  .cur.off,.cur-r.off{opacity:0}
}
@media (hover:none),(pointer:coarse){.cur,.cur-r{display:none}}

/* ---------- small screens ---------- */
@media(max-width:749px){
  .core-in{gap:26px}
  .hud-bl,.hud-br{position:static}
  .hud-row{
    position:fixed;left:0;right:0;bottom:0;z-index:5;display:flex;align-items:flex-end;
    justify-content:space-between;gap:10px;padding:0 14px 16px
  }
  .hud-bc{bottom:auto;top:74px}
  .promo-in{gap:10px;padding:8px 8px 8px 13px}
  .promo-cta{display:none}
  .promo-msg{font-size:11.5px}
  .np{padding:7px 12px 7px 7px;gap:10px}
  .np-art{width:40px;height:40px}
  .np-t b{font-size:11px}
  .np-ctl{display:none}
  .buy{padding:7px 12px 7px 7px}
  .buy-m{width:36px;height:36px}
  .shopify{padding:8px 11px;font-size:11px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition-duration:.01ms!important}
  .mark,.menu a,.hud{opacity:1;transform:none;filter:none}
}
</style>

<section id="lf-{{ section.id }}" class="lf">
  <div class="stage" data-stage
    {% if section.settings.poster %}style="background-image:url({{ section.settings.poster | image_url: width: 1600 }})"{% endif %}>
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'auto' }}
    {%- elsif section.settings.video_url != blank -%}
      <div class="lf-embed">{{ section.settings.video_url | external_video_tag: loop: '1', autoplay: '1', muted: '1', controls: '0' }}</div>
    {%- elsif section.settings.video_asset != blank -%}
      <video data-film autoplay muted loop playsinline preload="auto"
        {% if section.settings.poster %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ webm_src | asset_url }}" type="video/webm">
        <source src="{{ section.settings.video_asset | asset_url }}" type="video/mp4">
      </video>
    {%- endif -%}
  </div>
  {%- if section.settings.grain -%}<div class="grain" aria-hidden="true"></div>{%- endif -%}

  {%- if promo_lines.size > 0 -%}
    <div class="promo" data-promo>
      <div class="promo-in">
        <span class="promo-dot" aria-hidden="true"></span>
        <span class="promo-track" data-promo-track aria-live="polite">
          {%- for block in promo_lines -%}
            <span class="promo-msg{% if forloop.first %} on{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endfor -%}
        </span>
        {%- if section.settings.promo_cta != blank -%}
          <a class="promo-cta" href="{{ section.settings.promo_cta_url | default: '#' }}">{{ section.settings.promo_cta }}</a>
        {%- endif -%}
        {%- if section.settings.promo_close -%}
          <button class="promo-x" type="button" data-promo-close aria-label="Dismiss">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 6l12 12M18 6L6 18"/></svg>
          </button>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <main class="core">
    <div class="core-in">
      <div class="mark">
        {%- if section.settings.show_orb -%}<span class="orb" aria-hidden="true"></span>{%- endif -%}
        {%- if section.settings.logo != blank -%}
          <img class="logo" src="{{ section.settings.logo | image_url: width: 640 }}" alt="{{ shop.name | escape }}" width="320" height="80">
        {%- elsif section.settings.logo_asset != blank -%}
          <img class="logo" src="{{ section.settings.logo_asset | asset_url }}" alt="{{ shop.name | escape }}" width="320" height="80">
        {%- else -%}
          <span class="word">{{ section.settings.wordmark | default: shop.name }}{% if section.settings.tm %}<sup>&trade;</sup>{% endif %}</span>
        {%- endif -%}
      </div>
      {%- if section.settings.menu != blank -%}
        <nav class="menu" aria-label="{{ section.settings.menu.title | escape }}">
          {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        </nav>
      {%- endif -%}
    </div>
  </main>

  {%- if section.settings.show_clock -%}
    <div class="hud hud-bc">
      <div class="clock"><b data-city>{{ section.settings.city }}</b>
        <span data-time data-tz="{{ section.settings.timezone }}">--:--:--</span></div>
    </div>
  {%- endif -%}

  <div class="hud-row">
    <div class="hud hud-bl">
      {%- if section.settings.np_show -%}
        <div class="np" data-np>
          {%- if section.settings.np_art != blank -%}
            <img class="np-art" src="{{ section.settings.np_art | image_url: width: 160 }}" alt="" width="52" height="52">
          {%- else -%}
            <span class="np-art" aria-hidden="true"></span>
          {%- endif -%}
          <span class="np-t">
            <b>{{ section.settings.np_track }}</b>
            <span>{{ section.settings.np_artist }}</span>
            {%- if section.settings.np_chip != blank -%}<span class="np-chip">{{ section.settings.np_chip }}</span>{%- endif -%}
          </span>
          <span class="np-ctl">
            <button type="button" class="np-play" data-np-toggle aria-label="Play preview">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" data-np-icon><path d="M8 5l11 7-11 7z"/></svg>
            </button>
          </span>
        </div>
      {%- endif -%}
    </div>

    <div class="hud hud-br">
      {%- if section.settings.drop_show -%}
        <a class="buy" href="{{ section.settings.drop_url | default: '#' }}">
          {%- if section.settings.drop_image != blank -%}
            <img class="buy-m" src="{{ section.settings.drop_image | image_url: width: 186 }}" alt="" width="62" height="62">
          {%- else -%}
            <span class="buy-m" aria-hidden="true" style="background:linear-gradient(150deg,#3A3630,#171613 70%)"></span>
          {%- endif -%}
          <span class="buy-t">
            <b>{{ section.settings.drop_title }}</b>
            <span>{{ section.settings.drop_sub }}{% if section.settings.drop_count != blank %} <i>{{ section.settings.drop_count }}</i>{% endif %}</span>
          </span>
          <span class="buy-go" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}

      {%- if section.settings.ship_show -%}
        <a class="ship" href="{{ section.settings.ship_url | default: '#' }}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5z"/><path d="M3 7.5 12 12l9-4.5M12 12v9"/></svg>
          {{ section.settings.ship_text }} <b>{{ section.settings.ship_amount }}</b>
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.cursor -%}
    <div class="cur off" data-cur aria-hidden="true"></div>
    <div class="cur-r off" data-cur-ring aria-hidden="true"></div>
  {%- endif -%}
</section>

<script>
(function(){
  "use strict";
  var root=document.getElementById('lf-{{ section.id }}');
  if(!root) return;
  var $=function(s){ return root.querySelector(s); };
  var out0=root.querySelector('[data-time]');

  /* the film: fade it in only once it can actually paint a frame */
  var stage=$('[data-stage]'), film=$('[data-film]');
  function ready(){ stage.classList.add('ready'); }
  if(film){
    if(film.readyState>=2) ready(); else film.addEventListener('loadeddata',ready);
    film.addEventListener('error',ready);
    /* autoplay can be refused, and a codec can be missing - the poster behind
       the film carries the screen either way, so reveal on a timer regardless */
    var pr=film.play(); if(pr&&pr.catch) pr.catch(function(){});
    setTimeout(ready,1200);
  }

  /* the clock: the city's local time, ticking */
  var TZ=(out0 && out0.dataset.tz) || 'America/New_York';
  var fmt=new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',second:'2-digit',
    hour12:false,timeZone:TZ});
  var out=out0;
  if(out) (function tick(){
    out.textContent=fmt.format(new Date()).replace(/:/g,' : ');
    setTimeout(tick,1000-(Date.now()%1000));
  })();

  /* the cursor: a dot that tracks exactly, a ring that lags behind it */
  var dot=$('[data-cur]'), ring=$('[data-cur-ring]');
  if(dot && matchMedia('(hover:hover) and (pointer:fine)').matches){
    document.body.classList.add('lf-cursor');
    var mx=innerWidth/2,my=innerHeight/2,rx=mx,ry=my,shown=false;
    addEventListener('mousemove',function(e){
      mx=e.clientX; my=e.clientY;
      dot.style.transform='translate('+mx+'px,'+my+'px)';
      if(!shown){ shown=true; dot.classList.remove('off'); ring.classList.remove('off'); }
    });
    (function follow(){
      rx+=(mx-rx)*.17; ry+=(my-ry)*.17;
      ring.style.transform='translate('+rx+'px,'+ry+'px)';
      requestAnimationFrame(follow);
    })();
    addEventListener('mousedown',function(){ document.body.classList.add('lf-press'); });
    addEventListener('mouseup',function(){ document.body.classList.remove('lf-press'); });
    addEventListener('mouseout',function(e){
      if(e.relatedTarget) return;
      dot.classList.add('off'); ring.classList.add('off');
    });
    /* anything clickable widens the ring */
    document.addEventListener('mouseover',function(e){
      document.body.classList.toggle('lf-hot', !!e.target.closest('#lf-{{ section.id }} a,#lf-{{ section.id }} button'));
    });
  }

  /* the promo header cycles its lines, and stays dismissed for the visit */
  var promo=$('[data-promo]');
  if(promo){
    if(sessionStorage.getItem('promo-off-{{ section.id }}')==='1'){ promo.remove(); }
    else{
      var msgs=Array.prototype.slice.call(promo.querySelectorAll('.promo-msg')), i=0;
      if(msgs.length>1){
        setInterval(function(){
          msgs[i].classList.remove('on');
          i=(i+1)%msgs.length;
          msgs[i].classList.add('on');
        },4200);
      }
      $('[data-promo-close]').addEventListener('click',function(){
        promo.classList.add('gone');
        try{ sessionStorage.setItem('promo-off-{{ section.id }}','1'); }catch(e){}
        setTimeout(function(){ promo.remove(); },420);
      });
    }
  }

  /* the preview button drives the spinning sleeve */
  var np=$('[data-np]'), toggle=$('[data-np-toggle]'), icon=$('[data-np-icon]');
  if(!toggle) return;
  toggle.addEventListener('click',function(){
    var on=np.classList.toggle('playing');
    icon.innerHTML = on ? '<path d="M7 5h3.4v14H7zM13.6 5H17v14h-3.4z"/>' : '<path d="M8 5l11 7-11 7z"/>';
    toggle.setAttribute('aria-label', on ? 'Pause preview' : 'Play preview');
  });
})();
</script>

