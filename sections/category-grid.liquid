{% render 'section-style', s: section %}
<section class="sec-pad">
  <div class="wrap">
    <div class="sec-head">
      {%- if section.settings.eyebrow != blank -%}<div class="mini">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-top:8px">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="cgrid" data-row data-max="{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <a class="ctile" href="{{ block.settings.link | default: c.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <div class="ctile-m">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="" loading="lazy">
            {%- elsif c.featured_image -%}
              <img src="{{ c.featured_image | image_url: width: 900 }}" alt="" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="ctile-b">
            <span class="ctile-t">{{ block.settings.label | default: c.title }}</span>
            {%- assign ccount = c.products_count | plus: 0 -%}
            {%- if ccount > 0 -%}<span class="ctile-c">{{ ccount }} item{% unless ccount == 1 %}s{% endunless %}</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Category grid",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find your fit"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "alt",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Extra top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "header",
      "content": "Section type"
    },
    {
      "type": "paragraph",
      "content": "Leave these alone and the section follows the site's typography. Set them only when this one section needs to differ."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font for this section",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category grid",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
