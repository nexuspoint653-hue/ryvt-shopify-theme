{%- comment -%}
  The document layout: masthead, a contents rail that sticks, and numbered
  sections. Used by every legal and help page — terms, privacy, shipping, the
  social disclaimer, FAQ and contact.
{%- endcomment -%}
<div class="doc-hd">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.lede != blank -%}<p>{{ section.settings.lede }}</p>{%- endif -%}
    {%- if section.settings.meta_1 != blank or section.settings.meta_2 != blank -%}
      <div class="doc-meta">
        {%- if section.settings.meta_1 != blank -%}<span>{{ section.settings.meta_1 }}</span>{%- endif -%}
        {%- if section.settings.meta_2 != blank -%}<span>{{ section.settings.meta_2 }}</span>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

<div class="wrap doc">
  <aside class="doc-nav">
    <h4>On this page</h4>
    <ol>
      {%- for block in section.blocks -%}
        <li><a href="#doc-{{ forloop.index }}">{{ block.settings.title }}</a></li>
      {%- endfor -%}
    </ol>
  </aside>
  <div class="doc-body">
    {%- for block in section.blocks -%}
      <section id="doc-{{ forloop.index }}" {{ block.shopify_attributes }}>
        <h2><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>{{ block.settings.title }}</h2>
        {{ block.settings.body }}
      </section>
    {%- else -%}
      <section>{{ page.content }}</section>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Document",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Legal" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Falls back to the page title." },
    { "type": "textarea", "id": "lede", "label": "Standfirst" },
    { "type": "text", "id": "meta_1", "label": "First detail" },
    { "type": "text", "id": "meta_2", "label": "Second detail" }
  ],
  "blocks": [
    {
      "type": "part",
      "name": "Section",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Section title" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Write the section here.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Document" }]
}
{% endschema %}
