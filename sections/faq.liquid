{% render 'section-style', s: section %}
<section class="faqx sec-pad">
  <div class="faqx-head">
    {%- if section.settings.eyebrow != blank -%}<div class="mini" data-rv>{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="ed-h ed-serif" data-rv style="margin-top:14px">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}<p class="ed-p" data-rv>{{ section.settings.intro }}</p>{%- endif -%}
  </div>

  {%- assign groups = '' -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.group != blank -%}
      {%- unless groups contains block.settings.group -%}
        {%- assign groups = groups | append: block.settings.group | append: '|' -%}
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign glist = groups | split: '|' -%}

  {%- if glist.size > 1 -%}
    <nav class="faqx-tabs" aria-label="Topics">
      <button type="button" class="on" data-faq-tab="all">All</button>
      {%- for g in glist -%}
        <button type="button" data-faq-tab="{{ g | handleize }}">{{ g }}</button>
      {%- endfor -%}
    </nav>
  {%- endif -%}

  <div class="faqx-body">
    {%- assign group = '' -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.group != blank and block.settings.group != group -%}
        {%- assign group = block.settings.group -%}
        <div class="faqx-g" data-faq-group="{{ group | handleize }}">
          <div class="mini faqx-gl">{{ group }}</div>
        </div>
      {%- endif -%}
      <div class="faqx-row" data-faq-group="{{ group | handleize }}" {{ block.shopify_attributes }}>
        <button type="button" class="faqx-q" aria-expanded="false">
          <span>{{ block.settings.q }}</span>
          <i class="faqx-i" aria-hidden="true"></i>
        </button>
        <div class="faqx-a"><div class="rte">{{ block.settings.a }}</div></div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.foot != blank -%}
    <div class="faqx-foot" data-rv>
      <p class="ed-p" style="margin:0">{{ section.settings.foot }}</p>
      {%- if section.settings.foot_link_text != blank -%}
        <a class="btn" href="{{ section.settings.foot_link }}">{{ section.settings.foot_link_text }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>
<script>
(function(){
  document.querySelectorAll('.faqx').forEach(function(root){
    root.querySelectorAll('.faqx-q').forEach(function(btn){
      btn.addEventListener('click', function(){
        var open = btn.getAttribute('aria-expanded') === 'true';
        root.querySelectorAll('.faqx-q[aria-expanded="true"]').forEach(function(o){
          if(o !== btn){ o.setAttribute('aria-expanded','false'); o.parentElement.classList.remove('on'); }
        });
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        btn.parentElement.classList.toggle('on', !open);
      });
    });
    var tabs = root.querySelectorAll('[data-faq-tab]');
    tabs.forEach(function(t){
      t.addEventListener('click', function(){
        tabs.forEach(function(x){ x.classList.remove('on'); });
        t.classList.add('on');
        var key = t.getAttribute('data-faq-tab');
        root.querySelectorAll('[data-faq-group]').forEach(function(el){
          el.style.display = (key === 'all' || el.getAttribute('data-faq-group') === key) ? '' : 'none';
        });
      });
    });
  });
})();
</script>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Help Centre" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "text", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "foot", "label": "Footer note", "default": "Still need a hand?" },
    { "type": "text", "id": "foot_link_text", "label": "Footer button", "default": "Contact Us" },
    { "type": "url", "id": "foot_link", "label": "Footer button link" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "light",
      "options": [{"value":"light","label":"White"},{"value":"alt","label":"Off-white"},
                  {"value":"sand","label":"Sand"},{"value":"dark","label":"Dark"},{"value":"custom","label":"Custom"}] },
    { "type": "color", "id": "bg_custom", "label": "Custom background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_custom", "label": "Custom text", "default": "#111111" },
    { "type": "range", "id": "pad_top", "label": "Extra top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Extra bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "qa", "name": "Question", "settings": [
      { "type": "text", "id": "group", "label": "Group heading", "info": "Only shown when it changes — use it to start a new group." },
      { "type": "text", "id": "q", "label": "Question", "default": "How long does shipping take?" },
      { "type": "richtext", "id": "a", "label": "Answer", "default": "<p>Your delivery estimate is shown at checkout, before you pay.</p>" }
    ]}
  ],
  "presets": [{ "name": "FAQ", "blocks": [{"type":"qa"},{"type":"qa"},{"type":"qa"}] }]
}
{% endschema %}
