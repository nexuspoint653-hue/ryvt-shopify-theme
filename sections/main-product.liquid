{%- comment -%}
  Product — the site's PDP: gallery left, everything you decide with on the
  right. Colour and size are real Shopify variants; the accordions read from
  the product's own description and metafields.
{%- endcomment -%}
{%- liquid
  assign v = product.selected_or_first_available_variant
  assign ship_over = settings.ship_threshold | default: '125'
  assign ship_time = settings.ship_time | default: '48 hours'
  assign ship_from = settings.ship_from | default: 'Metro Detroit'
  assign ret_days = settings.returns_days | default: '30'
-%}

<div class="wrap">
  <div class="crumbs">
    <a href="{{ routes.root_url }}">Home</a> /
    <a href="{{ routes.all_products_collection_url }}">Shop All</a> /
    <span>{{ product.title }}</span>
  </div>

  <div class="pdp">
    <div>
      <div class="pdp-stage" data-pdp-stage>
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1400 | image_tag:
             class: 'pdp-main', widths: '600,900,1400', sizes: '(max-width:900px) 100vw, 55vw',
             alt: product.title, fetchpriority: 'high' }}
        {%- else -%}
          <span class="ph"></span>
        {%- endif -%}
        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbs">
            {%- for m in product.media limit: 6 -%}
              <button type="button" class="pdp-thumb{% if forloop.first %} on{% endif %}"
                      data-media="{{ m.id }}" aria-label="View image {{ forloop.index }}">
                <img src="{{ m | image_url: width: 200 }}" alt="" width="200" height="250" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- assign film = product.media | where: 'media_type', 'video' | first -%}
      {%- if film -%}
        <div class="motion">
          {{ film | video_tag: image_size: '900x', autoplay: true, loop: true, muted: true,
             controls: false, playsinline: true }}
          <div class="cap">{{ section.settings.motion_caption }}</div>
        </div>
      {%- endif -%}
    </div>

    <div class="side">
      {%- if product.type != blank -%}<div class="lab">{{ product.type }}</div>{%- endif -%}
      <h1 style="margin-top:8px">{{ product.title }}</h1>
      <div class="price">
        {%- if v.compare_at_price > v.price -%}
          <s style="opacity:.55">{{ v.compare_at_price | money_without_trailing_zeros }}</s>
        {%- endif -%}
        {{ v.price | money_without_trailing_zeros }}
      </div>
      {%- if product.description != blank -%}
        <p class="blurb">{{ product.description | strip_html | truncatewords: 44 }}</p>
      {%- endif -%}

      {%- form 'product', product, id: 'pdp-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ v.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          {%- for opt in product.options_with_values -%}
            {%- assign oname = opt.name | downcase -%}
            {%- if oname contains 'color' or oname contains 'colour' -%}
              <div class="opt" data-color-block>
                <div class="lab"><span>{{ opt.name }} &mdash;
                  <b data-color-name style="font-weight:600">{{ opt.selected_value }}</b></span></div>
                <div class="colors" data-colors>
                  {%- for val in opt.values -%}
                    <button type="button" class="sw-btn{% if val == opt.selected_value %} on{% endif %}"
                            data-opt="{{ opt.position }}" data-val="{{ val | escape }}"
                            title="{{ val | escape }}" aria-label="{{ val | escape }}">
                      <i style="background:{% if val.swatch.color %}{{ val.swatch.color }}{% else %}{% render 'swatch-color', name: val %}{% endif %}"></i>
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- else -%}
              <div class="opt">
                <div class="lab"><span>{{ opt.name }}</span>
                  {%- if section.settings.size_guide != blank -%}
                    <a href="{{ section.settings.size_guide }}">Size guide</a>
                  {%- endif -%}
                </div>
                <div class="sizes" data-sizes>
                  {%- for val in opt.values -%}
                    <button type="button" class="{% if val == opt.selected_value %}on{% endif %}"
                            data-opt="{{ opt.position }}" data-val="{{ val | escape }}">{{ val }}</button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        <button class="add" type="submit" name="add" data-add {% unless v.available %}disabled{% endunless %}>
          {%- if v.available -%}Add to bag &mdash; {{ v.price | money_without_trailing_zeros }}{%- else -%}Sold out{%- endif -%}
        </button>
      {%- endform -%}

      <div class="pdp-ship" data-ship tabindex="0">Ships in <b>{{ ship_time }}</b> from {{ ship_from }}
        &middot; Free over <b>{{ ship_over | prepend: '$' }}</b></div>

      <ul class="pdp-trust">
        <li><b>{{ ship_time }}</b>dispatch</li>
        <li><b>{{ ret_days }} days</b>to return</li>
        <li><b>1 year</b>against faults</li>
      </ul>

      <div class="acc">
        {%- if product.description != blank -%}
          <details open>
            <summary>Details</summary>
            <div class="body">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'panel' -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.title }}</summary>
              <div class="body">{{ block.settings.body }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

<script>
  window.__ryvtVariants = [
    {%- for var in product.variants -%}
      {
        "id": {{ var.id }},
        "options": {{ var.options | json }},
        "available": {{ var.available | json }},
        "price_formatted": {{ var.price | money_without_trailing_zeros | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];
</script>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "url", "id": "size_guide", "label": "Size guide page" },
    { "type": "text", "id": "motion_caption", "label": "Video caption", "default": "Worn, not styled" }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Accordion panel",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fit & sizing" },
        { "type": "richtext", "id": "body", "label": "Body",
          "default": "<p>Boxy through the body with a set shoulder. True to size for a relaxed fit; size down for a closer one.</p>" }
      ]
    }
  ]
}
{% endschema %}
