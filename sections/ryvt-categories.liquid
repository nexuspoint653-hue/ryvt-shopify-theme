{%- comment -%} Category tiles — each one points at a collection. {%- endcomment -%}
<section class="sec wrap">
  <div class="sec-h">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 style="margin-top:8px">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.body != blank -%}<p>{{ section.settings.body }}</p>{%- endif -%}
    </div>
    {%- if section.settings.more_text != blank -%}
      <a class="more" href="{{ section.settings.more_link | default: routes.all_products_collection_url }}">{{ section.settings.more_text }}</a>
    {%- endif -%}
  </div>
  <div class="cats">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign img = block.settings.image | default: c.featured_image -%}
      <a class="cat" href="{{ c.url | default: block.settings.link }}" {{ block.shopify_attributes }}>
        <span class="fig">
          {%- if img != blank -%}
            <img src="{{ img | image_url: width: 800 }}" alt="{{ block.settings.title | escape }}"
                 width="800" height="1000" loading="lazy">
          {%- else -%}
            <span class="ph{% cycle '', ' alt', ' dark', ' alt' %}"></span>
          {%- endif -%}
        </span>
        <span class="cat-lab">
          <span><b>{{ block.settings.title | default: c.title }}</b><span>{{ c.all_products_count }} styles</span></span>
          <span class="cat-go">&rarr;</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "RYVT categories",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four categories, one fit standard." },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "text", "id": "more_text", "label": "Link text", "default": "Shop all" },
    { "type": "url", "id": "more_link", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title override" },
        { "type": "image_picker", "id": "image", "label": "Photograph",
          "info": "Falls back to the collection's own image." },
        { "type": "url", "id": "link", "label": "Link override" }
      ]
    }
  ],
  "presets": [{ "name": "RYVT categories", "blocks": [
    { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
  ]}]
}
{% endschema %}
