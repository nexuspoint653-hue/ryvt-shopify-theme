{%- comment -%} The bag. {%- endcomment -%}
<div class="wrap shop-hd">
  <h1>Your bag</h1>
  <p>{% if cart.item_count == 0 %}Nothing in it yet.{% else %}{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}, ready when you are.{% endif %}</p>
</div>

<div class="wrap bag">
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="bag-items">
        {%- for line in cart.items -%}
          <div class="bag-line">
            <a class="bag-m" href="{{ line.url }}">
              {%- if line.image -%}
                <img src="{{ line.image | image_url: width: 300 }}" alt="{{ line.title | escape }}"
                     width="300" height="375" loading="lazy">
              {%- else -%}<span class="ph"></span>{%- endif -%}
            </a>
            <div class="bag-t">
              <a class="bag-n" href="{{ line.url }}">{{ line.product.title }}</a>
              {%- unless line.product.has_only_default_variant -%}
                <span class="bag-v">{{ line.variant.title }}</span>
              {%- endunless -%}
              <span class="bag-p">{{ line.final_line_price | money_without_trailing_zeros }}</span>
            </div>
            <div class="bag-q">
              <input type="number" name="updates[]" value="{{ line.quantity }}" min="0"
                     aria-label="Quantity for {{ line.title | escape }}">
              <a href="{{ line.url_to_remove }}">Remove</a>
            </div>
          </div>
        {%- endfor -%}
      </div>

      <aside class="bag-sum">
        <div class="bag-row"><span>Subtotal</span><b>{{ cart.total_price | money_without_trailing_zeros }}</b></div>
        <div class="bag-row muted"><span>Shipping</span><span>Calculated at checkout</span></div>
        <button type="submit" name="update" class="btn">Update</button>
        <button type="submit" name="checkout" class="btn btn-solid">Checkout</button>
        <p class="bag-note">Taxes and shipping calculated at checkout.</p>
      </aside>
    </form>
  {%- else -%}
    <div class="empty">
      <p>Nothing in the bag yet.</p>
      <a class="btn btn-solid" href="{{ routes.all_products_collection_url }}">Shop the drop</a>
    </div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
