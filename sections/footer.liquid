{% render 'section-style', s: section %}
{%- assign panels = section.blocks | where: "type", "panel" -%}
<footer>
  {%- if panels.size > 0 -%}
    <div class="f-panels">
      {%- for b in panels -%}
        <a class="f-panel" href="{{ b.settings.link | default: '#' }}" {{ b.shopify_attributes }}>
          {%- if b.settings.video != blank -%}
            <video class="f-panel-m" autoplay muted loop playsinline src="{{ b.settings.video }}"
              {% if b.settings.image %}poster="{{ b.settings.image | image_url: width: 1400 }}"{% endif %}></video>
          {%- elsif b.settings.image != blank -%}
            <img class="f-panel-m" src="{{ b.settings.image | image_url: width: 1400 }}" alt="" loading="lazy">
          {%- else -%}
            <span class="f-panel-m f-panel-ph"></span>
          {%- endif -%}
          <span class="f-panel-scrim"></span>
          <span class="f-panel-t">{{ b.settings.title }}</span>
          {%- if b.settings.caption != blank -%}<span class="f-panel-c">{{ b.settings.caption }}</span>{%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  {%- endif -%}
  <div class="f-main">
    <div>
      <h4>{{ section.settings.nl_title }}</h4>
      {%- if section.settings.nl_body != blank -%}<p class="small">{{ section.settings.nl_body }}</p>{%- endif -%}
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="nl">
          <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required>
          <input type="text" name="contact[first_name]" placeholder="First name" aria-label="First name">
        </div>
        <input type="tel" name="contact[phone]" class="nl-phone" placeholder="Phone number (optional)" aria-label="Phone number">
        {%- if section.settings.consent != blank -%}
          <div class="consent"><input type="checkbox" id="ryvt-consent" name="contact[accepts_marketing]">
            <label for="ryvt-consent">{{ section.settings.consent }}</label></div>
        {%- endif -%}
        <button type="submit" class="sub">Subscribe</button>
        {%- if form.posted_successfully? -%}<p class="small" style="margin-top:12px">Thank you — you're on the list.</p>{%- endif -%}
      {% endform %}
      {% render 'social-icons' %}
    </div>

    <div class="f-cols">
      {%- for block in section.blocks -%}
        {%- assign list = linklists[block.settings.menu] -%}
        <div {{ block.shopify_attributes }}>
          <h5>{{ block.settings.title | default: list.title }}</h5>
          <ul>
            {%- for link in list.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="f-bottom">
    <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
    <div style="display:flex;gap:16px">
      {%- assign legal = linklists[section.settings.legal_menu] -%}
      {%- for l in legal.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "nl_title",
      "label": "Newsletter heading",
      "default": "Join the movement"
    },
    {
      "type": "textarea",
      "id": "nl_body",
      "label": "Newsletter body",
      "default": "First to know about new drops, exclusive offers, and stories from Detroit."
    },
    {
      "type": "textarea",
      "id": "consent",
      "label": "Consent text",
      "default": "By signing up you consent to receive marketing messages from RYVT. Message frequency varies. Unsubscribe at any time."
    },
    {
      "type": "link_list",
      "id": "legal_menu",
      "label": "Legal menu"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "alt",
          "label": "Off-white"
        },
        {"value":"sand","label":"Sand"},
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Extra top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    { "type": "panel", "name": "Footer panel", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "url", "id": "video", "label": "Video file URL" },
      { "type": "text", "id": "title", "label": "Title", "default": "Discover RYVT" },
      { "type": "text", "id": "caption", "label": "Caption" },
      { "type": "url", "id": "link", "label": "Link" }
    ]},
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ]
}
{% endschema %}
