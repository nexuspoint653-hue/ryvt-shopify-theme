<footer>
  <div class="f-main">
    <div>
      <h4>{{ section.settings.nl_title }}</h4>
      {%- if section.settings.nl_body != blank -%}<p class="small">{{ section.settings.nl_body }}</p>{%- endif -%}
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="nl">
          <input type="email" name="contact[email]" placeholder="Email address" aria-label="Email address" required>
          <input type="text" name="contact[first_name]" placeholder="First name" aria-label="First name">
        </div>
        <input type="tel" name="contact[phone]" class="nl-phone" placeholder="Phone number (optional)" aria-label="Phone number">
        {%- if section.settings.consent != blank -%}
          <div class="consent"><input type="checkbox" id="ryvt-consent" name="contact[accepts_marketing]">
            <label for="ryvt-consent">{{ section.settings.consent }}</label></div>
        {%- endif -%}
        <button type="submit" class="sub">Subscribe</button>
        {%- if form.posted_successfully? -%}<p class="small" style="margin-top:12px">Thank you — you're on the list.</p>{%- endif -%}
      {% endform %}
    </div>

    <div class="f-cols">
      {%- for block in section.blocks -%}
        {%- assign list = linklists[block.settings.menu] -%}
        <div {{ block.shopify_attributes }}>
          <h5>{{ block.settings.title | default: list.title }}</h5>
          <ul>
            {%- for link in list.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="f-bottom">
    <div class="socials">
      {%- if settings.social_instagram != blank -%}
        <a href="{{ settings.social_instagram }}" aria-label="Instagram"><svg viewBox="0 0 24 24"><path d="M12 2c2.7 0 3 0 4.1.1 1.1 0 1.7.2 2.1.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.2.4.4 1 .4 2.1.1 1.1.1 1.4.1 4.1s0 3-.1 4.1c0 1.1-.2 1.7-.4 2.1-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.2-1 .4-2.1.4-1.1.1-1.4.1-4.1.1s-3 0-4.1-.1c-1.1 0-1.7-.2-2.1-.4a3.6 3.6 0 01-1.3-.9 3.6 3.6 0 01-.9-1.3c-.2-.4-.4-1-.4-2.1C2.2 15 2.2 14.7 2.2 12s0-3 .1-4.1c0-1.1.2-1.7.4-2.1.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.2 1-.4 2.1-.4C8.1 2.1 8.4 2 11.1 2H12zm0 3.4a6.6 6.6 0 100 13.2 6.6 6.6 0 000-13.2zm0 2.3a4.3 4.3 0 110 8.6 4.3 4.3 0 010-8.6zm6.9-2.6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/></svg></a>
      {%- endif -%}
      {%- if settings.social_tiktok != blank -%}
        <a href="{{ settings.social_tiktok }}" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M16.5 2h-3v13.2a2.7 2.7 0 11-2.7-2.7c.3 0 .5 0 .7.1V9.5a6 6 0 00-.7 0 5.8 5.8 0 105.8 5.8V8.9c1 .7 2.3 1.1 3.6 1.1V7c-1.9 0-3.4-1.5-3.7-3.4V2z"/></svg></a>
      {%- endif -%}
    </div>
    <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</div>
    <div style="display:flex;gap:16px">
      {%- assign legal = linklists[section.settings.legal_menu] -%}
      {%- for l in legal.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "nl_title", "label": "Newsletter heading", "default": "Join the movement" },
    { "type": "textarea", "id": "nl_body", "label": "Newsletter body", "default": "First to know about new drops, exclusive offers, and stories from Detroit." },
    { "type": "textarea", "id": "consent", "label": "Consent text", "default": "By signing up you consent to receive marketing messages from RYVT. Message frequency varies. Unsubscribe at any time." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu" }
  ],
  "blocks": [
    { "type": "menu", "name": "Link column", "settings": [
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "link_list", "id": "menu", "label": "Menu" }
    ]}
  ]
}
{% endschema %}
