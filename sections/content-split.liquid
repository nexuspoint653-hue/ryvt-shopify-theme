{% render 'section-style', s: section %}
<section class="csplit{% if section.settings.flip %} flip{% endif %}">
  <div class="csplit-m">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="" loading="lazy">
    {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
  </div>
  <div class="csplit-b">
    {%- if section.settings.eyebrow != blank -%}<div class="mini">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2" style="margin-top:10px">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<div class="rte lede">{{ section.settings.body }}</div>{%- endif -%}
    {%- if section.settings.link_text != blank -%}
      <div style="margin-top:22px"><a class="btn" href="{{ section.settings.link }}">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Content split",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "flip",
      "label": "Image on the right",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built Different"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Born in Metro Detroit. Engineered for movement.</p>"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "alt",
          "label": "Off-white"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Extra top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "header",
      "content": "Section type"
    },
    {
      "type": "paragraph",
      "content": "Leave these alone and the section follows the site's typography. Set them only when this one section needs to differ."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font for this section",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 60,
      "max": 160,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Spacing"
    }
  ],
  "presets": [
    {
      "name": "Content split"
    }
  ]
}
{% endschema %}
