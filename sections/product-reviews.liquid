{% render 'section-style', s: section %}
{%- liquid
  assign total = 0
  assign sum = 0
  assign c5 = 0
  assign c4 = 0
  assign c3 = 0
  assign c2 = 0
  assign c1 = 0
  for b in section.blocks
    assign sc = b.settings.score | plus: 0
    assign sum = sum | plus: sc
    assign total = total | plus: 1
    case sc
      when 5 then assign c5 = c5 | plus: 1
      when 4 then assign c4 = c4 | plus: 1
      when 3 then assign c3 = c3 | plus: 1
      when 2 then assign c2 = c2 | plus: 1
      else assign c1 = c1 | plus: 1
    endcase
  endfor
  assign avg = 0
  if total > 0
    assign avg = sum | times: 100 | divided_by: total
  endif
-%}
<section class="rev" id="reviews" data-count-group>
  <div class="sec-head" style="display:flex;align-items:baseline;justify-content:space-between;gap:20px;flex-wrap:wrap">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.cta_text != blank -%}
      <a class="ulink" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
    {%- endif -%}
  </div>

  {%- if total > 0 -%}
    <div class="rev-grid">
      <div>
        <div class="big">
          <span class="n" data-count>{{ avg | divided_by: 100.0 | round: 1 }}</span>
          <div style="padding-bottom:6px">
            {%- assign rounded = avg | divided_by: 100 -%}
            <span class="stars" aria-label="{{ avg | divided_by: 100.0 | round: 1 }} out of 5">
              {%- for i in (1..5) -%}
                <svg{% if i > rounded %} class="off"{% endif %} viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.2l1.4-7L2 9.4l7-.8z"/></svg>
              {%- endfor -%}
            </span>
            <div class="rmeta" style="margin-top:6px">Based on {{ total }} review{% unless total == 1 %}s{% endunless %}</div>
          </div>
        </div>
        <div class="bars">
          {%- assign counts = c5 | append: ',' | append: c4 | append: ',' | append: c3 | append: ',' | append: c2 | append: ',' | append: c1 | split: ',' -%}
          {%- for cnt in counts -%}
            {%- assign star = 5 | minus: forloop.index0 -%}
            {%- assign nval = cnt | plus: 0 -%}
            {%- assign pct = 0 -%}
            {%- if total > 0 -%}{%- assign pct = nval | times: 100 | divided_by: total -%}{%- endif -%}
            <div class="bar">
              <span>{{ star }}</span>
              <span class="t"><i style="width:{{ pct }}%"></i></span>
              <span class="c">{{ nval }}</span>
            </div>
          {%- endfor -%}
        </div>
        {%- if section.settings.note != blank -%}
          <p class="rmeta" style="margin-top:18px;max-width:34ch">{{ section.settings.note }}</p>
        {%- endif -%}
      </div>

      <div>
        {%- for b in section.blocks -%}
          {%- assign sc = b.settings.score | plus: 0 -%}
          <article class="ritem" {{ b.shopify_attributes }}>
            <div class="rtop">
              <span class="stars" aria-label="{{ sc }} out of 5">
                {%- for i in (1..5) -%}
                  <svg{% if i > sc %} class="off"{% endif %} viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.2l1.4-7L2 9.4l7-.8z"/></svg>
                {%- endfor -%}
              </span>
              {%- if b.settings.verified -%}<span class="verified">Verified buyer</span>{%- endif -%}
            </div>
            {%- if b.settings.title != blank -%}<h3 class="rtitle">{{ b.settings.title }}</h3>{%- endif -%}
            {%- if b.settings.body != blank -%}<p class="rbody">{{ b.settings.body }}</p>{%- endif -%}
            <div class="rmeta">
              {{ b.settings.name }}{% if b.settings.meta != blank %} &middot; {{ b.settings.meta }}{% endif %}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <p class="rmeta" style="margin-top:18px">{{ section.settings.empty }}</p>
  {%- endif -%}
</section>
{% schema %}
{
  "name": "Product reviews",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Add a review per block. The average, star bars and count are worked out for you. Swap this section for your review app when one is installed."
    },
