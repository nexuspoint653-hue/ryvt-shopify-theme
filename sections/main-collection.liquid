{%- comment -%}
  Shop — the site's layout: title left, standing description right, a tuck-away
  filter, then the three-up grid. Filtering and sorting use Shopify's own
  facets so they work with any catalogue.
{%- endcomment -%}
{%- liquid
  assign shown = collection.products_count
  assign active = 0
  for f in collection.filters
    assign active = active | plus: f.active_values.size
  endfor
-%}

<div class="wrap shop-hd">
  <h1>{{ collection.title | default: 'Shop' }}</h1>
  {%- if collection.description != blank -%}
    <p>{{ collection.description | strip_html | truncatewords: 46 }}</p>
  {%- elsif section.settings.body != blank -%}
    <p>{{ section.settings.body }}</p>
  {%- endif -%}
</div>

<div class="wrap shop-bar">
  <span class="shop-tally" data-count>{{ shown }} {% if shown == 1 %}style{% else %}styles{% endif %}</span>
  {%- if collection.filters.size > 0 or section.settings.show_sort -%}
    <button class="filt-btn" type="button" data-filt-toggle aria-expanded="false" aria-controls="filt-panel">
      <span class="filt-btn-t">Filter</span>
      <span class="filt-chip" data-filt-chip {% if active == 0 %}hidden{% endif %}>{{ active }}</span>
      <span class="filt-ic" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  {%- endif -%}
</div>

{%- if collection.filters.size > 0 or section.settings.show_sort -%}
<div class="filt-panel" id="filt-panel" data-filt-panel {% if active == 0 %}hidden{% endif %}>
  <form class="wrap filt-in" id="facets">
    {%- for f in collection.filters -%}
      {%- if f.type == 'list' -%}
        <div class="filt-grp">
          <span class="filt-lab">{{ f.label }}</span>
          <div class="filters">
            {%- for v in f.values -%}
              <label class="filt-opt">
                <input type="checkbox" name="{{ v.param_name }}" value="{{ v.value }}"
                       {% if v.active %}checked{% endif %} {% if v.count == 0 and v.active == false %}disabled{% endif %}
                       onchange="this.form.submit()">
                <span>{{ v.label }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.show_sort -%}
      <div class="filt-grp">
        <span class="filt-lab">Sort</span>
        <div class="filters">
          {%- assign cur = collection.sort_by | default: collection.default_sort_by -%}
          <select name="sort_by" class="filt-sort" onchange="this.form.submit()" aria-label="Sort by">
            {%- for opt in collection.sort_options -%}
              <option value="{{ opt.value }}" {% if opt.value == cur %}selected{% endif %}>{{ opt.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    {%- endif -%}

    {%- if active > 0 -%}
      <a class="filt-clear" href="{{ collection.url }}">Clear all</a>
    {%- endif -%}
  </form>
</div>
{%- endif -%}

<section class="sec wrap" style="padding-top:26px">
  {%- paginate collection.products by section.settings.per_page -%}
    <div class="grid indexed"{% if settings.card_swatches_hover %} data-swatch-hover{% endif %}{% if settings.card_show_index %} data-indexed{% endif %}>
      {%- for product in collection.products -%}
        {% render 'product-card', product: product, index: forloop.index %}
      {%- else -%}
        <div class="empty">
          <h3 class="h3">Nothing matches those filters</h3>
          <p>Try clearing one, or <a href="{{ routes.all_products_collection_url }}">see everything</a>.</p>
        </div>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pager">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "textarea", "id": "body", "label": "Standing description",
      "default": "Every RYVT style in one place. The same fit standard, the same 8.2 oz cotton, the same size run from XS to XXL, cut and finished in Metro Detroit.",
      "info": "Shown when the collection has no description of its own." },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}
