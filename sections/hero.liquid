{% render 'section-style', s: section %}
{%- if section.settings.pin -%}
<style>
  #shopify-section-{{ section.id }}{position:sticky;top:0;z-index:0}
  #shopify-section-{{ section.id }} ~ *{position:relative;z-index:1;background:var(--bg)}
  @media(prefers-reduced-motion:reduce){#shopify-section-{{ section.id }}{position:relative}}
</style>
{%- endif -%}
<section class="hero hero--{{ section.settings.height }}{% if section.settings.pin %} hero-pin{% endif %}"{% if section.settings.pin %} data-pin data-pin-fade="{{ section.settings.pin_fade }}"{% endif %}>
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" width="2400" height="1200" fetchpriority="high">
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
  <div class="hero-c">
    {%- if section.settings.eyebrow != blank -%}
      <div class="mini" style="margin-bottom:12px">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="h1">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.link_text != blank -%}
      <div style="margin-top:24px"><a href="{{ section.settings.link }}" class="btn btn-solid">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "pin",
      "label": "Pin while the next section scrolls over it",
      "default": true,
      "info": "The hero holds still and the section below slides up to cover it."
    },
    {
      "type": "range",
      "id": "pin_fade",
      "label": "Fade hero content as it is covered",
      "min": 0, "max": 100, "step": 10, "unit": "%",
      "default": 60
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "default": "std",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "tall", "label": "Tall (82%)" },
        { "value": "std",  "label": "Standard" }
      ]
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Premium Athletic Wear"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Detroit, On Your Back"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Button",
      "default": "Shop Men"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Background",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "White"
        },
        {
          "value": "alt",
          "label": "Off-white"
        },
        {"value":"sand","label":"Sand"},
        {
          "value": "dark",
          "label": "Dark"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "color",
      "id": "bg_custom",
      "label": "Custom background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_custom",
      "label": "Custom text",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Extra top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
