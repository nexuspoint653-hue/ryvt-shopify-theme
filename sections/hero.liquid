<section class="hero">
  {%- if section.settings.image != blank -%}
    <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" width="2400" height="1200" fetchpriority="high">
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
  {%- endif -%}
  <div class="hero-c">
    {%- if section.settings.eyebrow != blank -%}
      <div class="mini" style="margin-bottom:12px">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="h1">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.link_text != blank -%}
      <div style="margin-top:24px"><a href="{{ section.settings.link }}" class="btn btn-solid">{{ section.settings.link_text }}</a></div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Hero", "settings": [
  { "type": "image_picker", "id": "image", "label": "Image" },
  { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Premium Athletic Wear" },
  { "type": "text", "id": "heading", "label": "Heading", "default": "Detroit, On Your Back" },
  { "type": "text", "id": "link_text", "label": "Button", "default": "Shop Men" },
  { "type": "url", "id": "link", "label": "Link" }
], "presets": [{ "name": "Hero" }] }
{% endschema %}
