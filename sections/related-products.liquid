{%- comment -%}
  You might also like — the site's product row. It used to open with a `.cat`
  wrapper, which the ported stylesheet now uses for category tiles, so every
  product page inherited tile styling.
{%- endcomment -%}
{%- assign picks = product.collections | first -%}
<section class="sec wrap">
  <div class="sec-h">
    <div>
      {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
      <h2 style="margin-top:8px">{{ section.settings.heading }}</h2>
    </div>
    <a class="more" href="{{ routes.all_products_collection_url }}">Shop all</a>
  </div>
  <div class="grid"{% if settings.card_swatches_hover %} data-swatch-hover{% endif %}>
    {%- assign n = 0 -%}
    {%- for p in picks.products -%}
      {%- if p.id != product.id and n < section.settings.count -%}
        {%- assign n = n | plus: 1 -%}
        {% render 'product-card', product: p, index: n %}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Wear it with" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The rest of the fit." },
    { "type": "range", "id": "count", "label": "How many", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
