{%- assign menu = linklists[section.settings.menu] -%}
{%- assign notes = section.blocks | where: "type", "announcement" -%}
{%- assign cards = section.blocks | where: "type", "menu_card" -%}
{%- assign tiles = section.blocks | where: "type", "search_tile" -%}

{%- if notes.size > 0 -%}
  <div class="abar" id="abar" data-rotate="{{ section.settings.rotate_secs }}">
    <div class="abar-in">
      {%- for b in notes -%}
        <div class="abar-i{% if forloop.first %} on{% endif %}" {{ b.shopify_attributes }}>
          {%- if b.settings.link != blank -%}
            <a href="{{ b.settings.link }}">{{ b.settings.text }}</a>
          {%- else -%}{{ b.settings.text }}{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if section.settings.abar_dismiss -%}
      <button class="abar-x" id="abarX" type="button" aria-label="Dismiss"></button>
    {%- endif -%}
  </div>
{%- endif -%}

<header class="hdr" id="hdr"
  data-clear="{{ section.settings.transparent }}"
  data-autohide="{{ section.settings.autohide }}">
  <div class="hdr-in">

    <nav class="nav-c" aria-label="Main">
      <button class="burger" id="burger" type="button" data-tap aria-label="Open menu" aria-expanded="false">
        <i></i><i></i><i></i>
      </button>
      {%- for link in menu.links limit: 5 -%}
        {%- if link.links.size > 0 -%}
          <button type="button" class="nav-i" data-tap data-menu="mega-{{ forloop.index }}"
                  aria-expanded="false" aria-controls="mega-{{ forloop.index }}">{{ link.title }}</button>
        {%- else -%}
          <a href="{{ link.url }}" class="nav-i{% if link.active %} on{% endif %}" data-tap>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.soon_label != blank -%}
        <span class="nav-i dim">{{ section.settings.soon_label }}<span class="soon">Coming Soon</span></span>
      {%- endif -%}
    </nav>

    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}"
             style="max-height:{{ section.settings.logo_height }}px;width:auto">
      {%- else -%}
        <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true"><path d="M4 20 L14 8 L18 13 L28 3 L28 10 L18 20 L14 15 L8 22 Z M4 26 L14 14 L18 19 L28 9 L28 16 L18 26 L14 21 L8 28 Z"/></svg>
        <span class="logo-w">{{ section.settings.wordmark | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <div class="nav-r">
      <button class="ico" id="searchBtn" type="button" data-tap aria-label="Search" aria-expanded="false">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg></button>
      {%- if section.settings.show_saved -%}
        <a href="{{ section.settings.saved_url | default: routes.all_products_collection_url }}"
           class="ico" id="savedBtn" data-tap aria-label="Saved">
          <svg viewBox="0 0 24 24"><path d="M6 3h12v18l-6-5-6 5V3z"/></svg>
          <span class="cnt" data-saved-count>0</span>
        </a>
      {%- endif -%}
      <a href="{{ routes.account_url }}" class="ico hide-sm" data-tap aria-label="Account">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></a>
      <a href="{{ routes.cart_url }}" class="ico" data-tap aria-label="Bag ({{ cart.item_count }})">
        <svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg>
        <span class="cnt{% if cart.item_count > 0 %} on{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- comment -%} mega menu {%- endcomment -%}
  <div class="mega" id="mega">
    {%- for link in menu.links limit: 5 -%}
      {%- if link.links.size > 0 -%}
        {%- assign pos = forloop.index -%}
        {%- comment -%} flat menu (types only) vs grouped menu {%- endcomment -%}
        {%- assign grouped = false -%}
        {%- for col in link.links -%}
          {%- if col.links.size > 0 -%}{%- assign grouped = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}

        <div class="mega-in" id="mega-{{ pos }}" role="region" aria-label="{{ link.title }}">
          <div class="mega-cols{% unless grouped %} mega-flat{% endunless %}">
            {%- if grouped -%}
              {%- for col in link.links limit: 4 -%}
                <div class="mcol">
                  <h4>{{ col.title }}</h4>
                  <ul>
                    {%- if col.links.size > 0 -%}
                      {%- for item in col.links -%}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{%- endfor -%}
                    {%- else -%}
                      <li><a href="{{ col.url }}">{{ col.title }}</a></li>
                    {%- endif -%}
                  </ul>
                </div>
              {%- endfor -%}
              <div class="mcol mcol-all">
                <h4>&nbsp;</h4>
                <ul><li><a class="mall" href="{{ link.url }}">Shop all &rarr;</a></li></ul>
              </div>
            {%- else -%}
              <div class="mcol mcol-wide">
                <h4>{{ section.settings.types_label | default: 'Shop by type' }}</h4>
                <ul class="mlist">
                  {%- for col in link.links -%}<li><a href="{{ col.url }}">{{ col.title }}</a></li>{%- endfor -%}
                </ul>
                <div class="mcol-foot"><a class="mall" href="{{ link.url }}">Shop all &rarr;</a></div>
              </div>
            {%- endif -%}
          </div>

          <div class="mega-cards">
            {%- for block in cards -%}
              {%- if block.settings.position == pos -%}
                {%- assign pr = block.settings.product -%}
                {%- assign img_a = block.settings.image -%}
                {%- assign img_b = block.settings.image_hover -%}
                {%- if img_a == blank and pr != blank -%}{%- assign img_a = pr.featured_image -%}{%- endif -%}
                {%- if img_b == blank and pr != blank and pr.images.size > 1 -%}{%- assign img_b = pr.images[1] -%}{%- endif -%}
                {%- assign title = block.settings.label | default: pr.title -%}
                {%- assign href = block.settings.link | default: pr.url | default: link.url -%}
                <a class="mcard" href="{{ href }}" {{ block.shopify_attributes }}>
                  <div class="mcard-m">
                    {%- if img_a != blank -%}
                      <img class="pri" src="{{ img_a | image_url: width: 700 }}" alt="{{ title | escape }}" loading="lazy">
                    {%- else -%}
                      <span class="ph ph-a"></span>
                    {%- endif -%}
                    {%- if img_b != blank -%}
                      <img class="alt" src="{{ img_b | image_url: width: 700 }}" alt="" loading="lazy" aria-hidden="true">
                    {%- else -%}
                      <span class="ph ph-b alt"></span>
                    {%- endif -%}
                    {%- if block.settings.tag != blank -%}<span class="mcard-tag">{{ block.settings.tag }}</span>{%- endif -%}
                  </div>
                  <div class="mcard-b">
                    <span class="mcard-t">{{ title }}</span>
                    {%- if block.settings.caption != blank -%}
                      <span class="mcard-c">{{ block.settings.caption }}</span>
                    {%- elsif pr != blank and block.settings.show_price -%}
                      <span class="mcard-c">{{ pr.price | money }}</span>
                    {%- endif -%}
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- comment -%} search panel — full width, drops from the header {%- endcomment -%}
  <div class="spanel" id="search" role="dialog" aria-label="Search" aria-modal="false">
    <div class="spanel-in">
      <form class="sform" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg>
        <input class="sinput" type="search" name="q" id="sInput"
               placeholder="{{ section.settings.search_placeholder }}" autocomplete="off">
        <button class="sclear" type="button" id="sClear" aria-label="Clear"></button>
        <button class="ssubmit" type="submit">Search</button>
      </form>

      <div class="spanel-body">
        {%- if section.settings.popular != blank -%}
          <div class="scol">
            <h5 class="sh">Popular searches</h5>
            <div class="chips">
              {%- assign terms = section.settings.popular | split: ',' -%}
              {%- for t in terms -%}
                <a class="chip" href="{{ routes.search_url }}?q={{ t | strip | url_encode }}&type=product">{{ t | strip }}</a>
              {%- endfor -%}
            </div>
            {%- assign fabric = linklists[section.settings.fabric_menu] -%}
            {%- if fabric.links.size > 0 -%}
              <h5 class="sh" style="margin-top:26px">{{ section.settings.fabric_title }}</h5>
              <div class="slinks">
                {%- for l in fabric.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if tiles.size > 0 -%}
          <div class="scol scol-tiles">
            <h5 class="sh">Shop by category</h5>
            <div class="stiles">
              {%- for block in tiles -%}
                {%- assign coll = block.settings.collection -%}
                <a class="stile" href="{{ block.settings.link | default: coll.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy">
                  {%- elsif coll.featured_image -%}
                    <img src="{{ coll.featured_image | image_url: width: 500 }}" alt="" loading="lazy">
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  <span>{{ block.settings.label | default: coll.title }}</span>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</header>

<div class="scrim" id="scrim"></div>

<aside class="drawer" id="drawer" aria-label="Menu">
  <div class="drawer-h">
    <span class="mini">Menu</span>
    <button class="x" id="drawerX" type="button" data-tap aria-label="Close"></button>
  </div>
  <div class="drawer-b">
    <ul>
      {%- for link in menu.links -%}
        <li>
          {%- if link.links.size > 0 -%}
            <button type="button" data-tap data-sub="dsub-{{ forloop.index }}" aria-expanded="false">
              {{ link.title }} <span aria-hidden="true">+</span></button>
            <div class="drawer-sub" id="dsub-{{ forloop.index }}">
              {%- for col in link.links -%}
                {%- if col.links.size > 0 -%}
                  {%- for item in col.links -%}<a href="{{ item.url }}">{{ item.title }}</a>{%- endfor -%}
                {%- else -%}
                  <a href="{{ col.url }}">{{ col.title }}</a>
                {%- endif -%}
              {%- endfor -%}
              <a class="dall" href="{{ link.url }}">Shop all {{ link.title | downcase }} &rarr;</a>
            </div>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="drawer-f">
      <a href="{{ routes.account_url }}">Account</a>
      <a href="{{ routes.search_url }}">Search</a>
    </div>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 16, "max": 64, "step": 2, "unit": "px", "default": 26 },
    { "type": "text", "id": "wordmark", "label": "Wordmark (used if no logo image)", "default": "RYVT" },
    { "type": "text", "id": "soon_label", "label": "Greyed-out nav item" },
    { "type": "text", "id": "types_label", "label": "Heading over a flat Shop menu", "default": "Shop by type" },
    { "type": "header", "content": "Behaviour" },
    { "type": "checkbox", "id": "transparent", "label": "Transparent over a full-bleed first section", "default": true,
      "info": "White text over the hero, then solid white once you scroll past it." },
    { "type": "checkbox", "id": "autohide", "label": "Hide on scroll down, reveal on scroll up", "default": true },
    { "type": "checkbox", "id": "show_saved", "label": "Show saved items icon", "default": true },
    { "type": "url", "id": "saved_url", "label": "Saved items link" },
    { "type": "header", "content": "Announcement bar" },
    { "type": "range", "id": "rotate_secs", "label": "Rotate every", "min": 0, "max": 12, "step": 1, "unit": "s", "default": 5,
      "info": "0 turns rotation off." },
    { "type": "checkbox", "id": "abar_dismiss", "label": "Let shoppers dismiss it", "default": false },
    { "type": "header", "content": "Search panel" },
    { "type": "text", "id": "search_placeholder", "label": "Placeholder", "default": "Search for a tee, a fit, a fabric" },
    { "type": "text", "id": "popular", "label": "Popular searches (comma separated)", "default": "Heavyweight Tee, Tanks, Cargo Pants, Garment Dyed" },
    { "type": "text", "id": "fabric_title", "label": "Secondary link heading", "default": "Our Fabric" },
    { "type": "link_list", "id": "fabric_menu", "label": "Secondary menu" }
  ],
  "blocks": [
    { "type": "announcement", "name": "Announcement", "settings": [
      { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over $100" },
      { "type": "url", "id": "link", "label": "Link" }
    ]},
    { "type": "menu_card", "name": "Featured product card", "settings": [
      { "type": "range", "id": "position", "label": "Applies to menu item #", "min": 1, "max": 5, "step": 1, "default": 1 },
      { "type": "product", "id": "product", "label": "Featured product",
        "info": "Its first two photos become the hover swap. Images below override this." },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "image_picker", "id": "image_hover", "label": "Image on hover" },
      { "type": "text", "id": "label", "label": "Title", "default": "The Detroit Renaissance Heavyweight Tee" },
      { "type": "text", "id": "caption", "label": "Caption under title" },
      { "type": "checkbox", "id": "show_price", "label": "Show price when a product is picked", "default": false },
      { "type": "text", "id": "tag", "label": "Corner tag" },
      { "type": "url", "id": "link", "label": "Link" }
    ]},
    { "type": "search_tile", "name": "Search panel tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ]
}
{% endschema %}
