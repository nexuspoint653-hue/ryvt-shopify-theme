{%- assign menu = linklists[section.settings.menu] -%}
<header class="hdr" id="hdr">
  <div class="hdr-in">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 320 }}" alt="{{ shop.name | escape }}"
             style="max-height:{{ section.settings.logo_height }}px;width:auto">
      {%- else -%}
        <svg viewBox="0 0 32 32"><path d="M4 20 L14 8 L18 13 L28 3 L28 10 L18 20 L14 15 L8 22 Z M4 26 L14 14 L18 19 L28 9 L28 16 L18 26 L14 21 L8 28 Z"/></svg>
        {{ section.settings.wordmark | default: shop.name }}
      {%- endif -%}
    </a>

    <nav class="nav-c">
      {%- for link in menu.links limit: 4 -%}
        <a href="{{ link.url }}" class="nav-a nav-i"{% if link.links.size > 0 %} data-menu="mega-{{ forloop.index }}"{% endif %}>{{ link.title }}</a>
      {%- endfor -%}
      {%- if section.settings.soon_label != blank -%}
        <span class="nav-i dim">{{ section.settings.soon_label }}<span class="soon">Coming Soon</span></span>
      {%- endif -%}
    </nav>

    <div class="nav-r">
      <button class="burger" id="burger" aria-label="Menu"><i></i><i></i></button>
      <button class="ico" id="searchBtn" aria-label="Search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg></button>
      <a href="{{ routes.account_url }}" class="ico" aria-label="Account">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/></svg></a>
      <a href="{{ routes.cart_url }}" class="ico" aria-label="Bag">
        <svg viewBox="0 0 24 24"><path d="M6 8h12l1 12H5L6 8z"/><path d="M9 8V6a3 3 0 016 0v2"/></svg>
        {%- if cart.item_count > 0 -%}<span class="bagn">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>

  <div class="mega">
    {%- for link in menu.links limit: 4 -%}
      {%- if link.links.size > 0 -%}
        {%- assign pos = forloop.index -%}
        <div class="mega-in" id="mega-{{ pos }}">
          {%- for col in link.links limit: 3 -%}
            <div class="mcol">
              <h4>{{ col.title }}</h4>
              <ul>
                {%- if col.links.size > 0 -%}
                  {%- for item in col.links -%}<li><a href="{{ item.url }}">{{ item.title }}</a></li>{%- endfor -%}
                {%- else -%}
                  <li><a href="{{ col.url }}">Shop all</a></li>
                {%- endif -%}
              </ul>
            </div>
          {%- endfor -%}
          {%- if link.links.size < 3 -%}
            {%- for i in (link.links.size..2) -%}<div class="mcol"></div>{%- endfor -%}
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.position == pos -%}
              <a class="mcard" href="{{ block.settings.link | default: link.url }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 900 }}" alt="" loading="lazy">
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
                <span>{{ block.settings.label }}</span>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</header>
<div class="scrim" id="scrim"></div>

<aside class="search" id="search" aria-label="Search">
  <form class="search-top" action="{{ routes.search_url }}" method="get">
    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M16.5 16.5L21 21"/></svg>
    <input type="search" name="q" placeholder="Search products" autocomplete="off">
    <button type="button" class="x" id="searchX" aria-label="Close search"></button>
  </form>
  <div class="search-body">
    {%- if section.settings.popular != blank -%}
      <h5 class="sh">Popular Searches</h5>
      <div class="chips">
        {%- assign terms = section.settings.popular | split: ',' -%}
        {%- for t in terms -%}
          <a class="chip" href="{{ routes.search_url }}?q={{ t | strip | url_encode }}">{{ t | strip }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign tiles = section.blocks | where: "type", "search_tile" -%}
    {%- if tiles.size > 0 -%}
      <h5 class="sh">Shop by Category</h5>
      <div class="stiles">
        {%- for block in tiles -%}
          {%- assign coll = block.settings.collection -%}
          <a class="stile" href="{{ block.settings.link | default: coll.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="" loading="lazy">
            {%- elsif coll.featured_image -%}
              <img src="{{ coll.featured_image | image_url: width: 600 }}" alt="" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span>{{ block.settings.label | default: coll.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign fabric = linklists[section.settings.fabric_menu] -%}
    {%- if fabric.links.size > 0 -%}
      <h5 class="sh">{{ section.settings.fabric_title }}</h5>
      <div class="slinks">
        {%- for l in fabric.links -%}<a href="{{ l.url }}">{{ l.title }}</a>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</aside>

<aside class="drawer" id="drawer">
  <div class="drawer-h"><span class="mini">Menu</span><button class="x" id="drawerX" aria-label="Close"></button></div>
  <div class="drawer-b">
    <ul>
      {%- for link in menu.links -%}
        <li>
          {%- if link.links.size > 0 -%}
            <button data-sub="dsub-{{ forloop.index }}">{{ link.title }} <span>+</span></button>
            <div class="drawer-sub" id="dsub-{{ forloop.index }}">
              {%- for col in link.links -%}
                {%- if col.links.size > 0 -%}
                  {%- for item in col.links -%}<a href="{{ item.url }}">{{ item.title }}</a>{%- endfor -%}
                {%- else -%}
                  <a href="{{ col.url }}">{{ col.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
      <li><a href="{{ routes.account_url }}">Account</a></li>
    </ul>
  </div>
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "range", "id": "logo_height", "label": "Logo height", "min": 18, "max": 64, "step": 2, "unit": "px", "default": 26 },
    { "type": "text", "id": "wordmark", "label": "Wordmark (used if no logo image)", "default": "RYVT" },
    { "type": "text", "id": "soon_label", "label": "Greyed-out nav item", "default": "Women" },
    { "type": "text", "id": "popular", "label": "Popular searches (comma separated)", "default": "Heavyweight Tee, Tanks, Cargo Pants, Garment Dyed" },
    { "type": "text", "id": "fabric_title", "label": "Fabric link heading", "default": "Our Fabric" },
    { "type": "link_list", "id": "fabric_menu", "label": "Fabric menu" }
  ],
  "blocks": [
    { "type": "menu_card", "name": "Mega menu image", "settings": [
      { "type": "range", "id": "position", "label": "Applies to menu item #", "min": 1, "max": 4, "step": 1, "default": 1 },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Pill label", "default": "Shop Men" },
      { "type": "url", "id": "link", "label": "Link" }
    ]},
    { "type": "search_tile", "name": "Search panel tile", "settings": [
      { "type": "collection", "id": "collection", "label": "Collection" },
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "label", "label": "Label" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ]
}
{% endschema %}
