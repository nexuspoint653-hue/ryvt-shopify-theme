{%- comment -%}
  RYVT header — ported from the site markup so the ryvt.css classes match:
  sticky bar, mega menu, search pane. Every list is merchant-editable through
  blocks and menus rather than hardcoded.
{%- endcomment -%}
{%- liquid
  assign ship_over = settings.ship_threshold | default: '125'
  assign ship_time = settings.ship_time | default: '48 hours'
  assign ship_from = settings.ship_from | default: 'Metro Detroit'
  assign ret_days  = settings.returns_days | default: '30'
  assign all_count = collections.all.all_products_count
-%}

<div class="srch-scrim" data-scrim hidden></div>

<header class="hd">
  <div class="wrap hd-in">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- if settings.logo != blank -%}
        <img src="{{ settings.logo | image_url: width: 640 }}"
             alt="{{ shop.name | escape }}"
             width="{{ settings.logo_width }}" height="auto"
             style="width:{{ settings.logo_width }}px">
      {%- else -%}
        <span class="logo-txt">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="nav" aria-label="Main">
      {%- for link in section.settings.menu.links -%}
        {%- if forloop.first -%}
          <div data-menu>
            <button class="navbtn" data-drop="shop" data-shop-nav aria-expanded="false"
                    data-href="{{ link.url }}">
              <span class="nfx"><i>{{ link.title }}</i><i aria-hidden="true">{{ link.title }}</i></span>
            </button>
          </div>
        {%- else -%}
          <div><a class="navbtn" href="{{ link.url }}">
            <span class="nfx"><i>{{ link.title }}</i><i aria-hidden="true">{{ link.title }}</i></span>
            {%- if forloop.last and settings.logo_light != blank -%}
              <img class="nav-mark" src="{{ settings.logo_light | image_url: width: 120 }}" alt="" aria-hidden="true">
            {%- endif -%}
          </a></div>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="hd-r">
      <button class="ic" data-search-open aria-label="Search">
        <svg width="19" height="19" viewBox="0 0 19 19" fill="none" aria-hidden="true">
          <circle cx="8.2" cy="8.2" r="6.1" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12.7 12.7 L17 17" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </button>
      <a class="ic" href="{{ routes.account_url }}" aria-label="Account">
        <svg width="19" height="19" viewBox="0 0 19 19" fill="none" aria-hidden="true">
          <circle cx="9.5" cy="6.6" r="3.4" stroke="currentColor" stroke-width="1.6"/>
          <path d="M3 17c0-3.6 2.9-5.6 6.5-5.6S16 13.4 16 17" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </a>
      <a class="ic" href="{{ routes.cart_url }}" data-bag-open aria-label="Bag">
        <svg width="19" height="19" viewBox="0 0 19 19" fill="none" aria-hidden="true">
          <path d="M3.4 5.6h12.2l-1 11.4H4.4z" stroke="currentColor" stroke-width="1.6"/>
          <path d="M6.9 7.4V5.2a2.6 2.6 0 0 1 5.2 0v2.2" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        <span class="bagn" data-bagn {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
      <button class="ic burger" data-drop="shop" aria-label="Menu">
        <svg width="19" height="14" viewBox="0 0 19 14" aria-hidden="true">
          <path d="M0 1h19M0 7h19M0 13h19" stroke="currentColor" stroke-width="1.6"/>
        </svg>
      </button>
    </div>
  </div>

  {%- comment -%} The mega menu: two link columns, then featured products. {%- endcomment -%}
  <div class="drop" data-panel="shop">
    <div class="wrap drop-in">
      {%- assign col = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'column' -%}
          {%- assign col = col | plus: 1 -%}
          <div class="drop-col" style="--d:{{ col }}" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}<h4>{{ block.settings.heading }}</h4>{%- endif -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}
                  {%- if link.object.all_products_count -%}<i>{{ link.object.all_products_count }}</i>
                  {%- else -%}<i>&rarr;</i>{%- endif -%}
                </a></li>
              {%- endfor -%}
            </ul>
            {%- if block.settings.heading_2 != blank -%}<h4 class="mt">{{ block.settings.heading_2 }}</h4>{%- endif -%}
            {%- if block.settings.menu_2 != blank -%}
              <ul>
                {%- for link in block.settings.menu_2.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}
                    {%- if link.object.all_products_count -%}<i>{{ link.object.all_products_count }}</i>
                    {%- else -%}<i>&rarr;</i>{%- endif -%}
                  </a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div class="drop-feat" style="--d:3">
        {%- for block in section.blocks -%}
          {%- if block.type == 'featured' and block.settings.product != blank -%}
            {%- assign p = block.settings.product -%}
            <a class="dfeat" href="{{ p.url }}" {{ block.shopify_attributes }}>
              <span class="dfeat-m">
                {%- if p.featured_image -%}
                  <img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}"
                       width="500" height="666" loading="lazy">
                {%- else -%}<span class="ph"></span>{%- endif -%}
                {%- if block.settings.tag != blank -%}<span class="dfeat-tag">{{ block.settings.tag }}</span>{%- endif -%}
              </span>
              <span class="dfeat-n">{{ p.title }}</span><span class="dfeat-p">{{ p.price | money_without_trailing_zeros }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="drop-strip">
      <div class="wrap">
        <span><b>Free shipping</b> over {{ ship_over | prepend: '$' }}</span>
        <span><b>Ships in {{ ship_time }}</b> from {{ ship_from }}</span>
        <span><b>{{ ret_days }}-day returns</b> unworn, tags on</span>
        <a href="{{ routes.all_products_collection_url }}">Shop all {{ all_count }} styles &rarr;</a>
      </div>
    </div>
  </div>

  {%- comment -%} Search: results lead, shortcuts in the rail beside them. {%- endcomment -%}
  <div class="srch" data-srch>
    <form class="wrap srch-in" action="{{ routes.search_url }}" method="get" role="search">
      <div class="srch-row">
        <svg width="20" height="20" viewBox="0 0 19 19" fill="none" aria-hidden="true">
          <circle cx="8.2" cy="8.2" r="6.1" stroke="currentColor" stroke-width="1.6"/>
          <path d="M12.7 12.7 L17 17" stroke="currentColor" stroke-width="1.6"/>
        </svg>
        <input type="search" name="q" placeholder="What are you looking for?" data-q
               aria-label="Search products" autocomplete="off">
        <button class="srch-clear" type="button" data-search-clear hidden>Clear</button>
        <button class="srch-x" type="button" data-search-close>Close <span>esc</span></button>
      </div>

      <div class="srch-body">
        <div class="srch-main">
          <div class="srch-head">
            <h4 data-hits-h>Most wanted</h4>
            <span class="srch-count" data-hits-count></span>
          </div>
          <div class="hits" data-hits>
            {%- assign feat = section.settings.search_collection -%}
            {%- for p in feat.products limit: 4 -%}
              <a href="{{ p.url }}">
                <span class="hit-m">
                  {%- if p.featured_image -%}
                    <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}"
                         width="400" height="533" loading="lazy">
                  {%- else -%}<span class="ph"></span>{%- endif -%}
                </span>
                <p>{{ p.title }}</p><span>{{ p.price | money_without_trailing_zeros }}</span>
              </a>
            {%- endfor -%}
          </div>
        </div>

        <div class="srch-side">
          {%- if section.settings.terms != blank -%}
            <div>
              <h4 data-sugg-h>Popular right now</h4>
              <ul class="srch-terms">
                {%- assign terms = section.settings.terms | split: ',' -%}
                {%- for t in terms -%}
                  {%- assign tt = t | strip -%}
                  <li><button type="button" data-term="{{ tt | escape }}">{{ tt }}</button></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          {%- if section.settings.jump_menu != blank -%}
            <div>
              <h4>Jump to</h4>
              <ul class="srch-jump">
                {%- for link in section.settings.jump_menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}
                    {%- if link.object.all_products_count -%}<i>{{ link.object.all_products_count }}</i>
                    {%- else -%}<i>&rarr;</i>{%- endif -%}
                  </a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      </div>
    </form>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu",
      "info": "The first item opens the mega menu below; the rest are plain links." },
    { "type": "header", "content": "Search pane" },
    { "type": "collection", "id": "search_collection", "label": "Products shown before anyone types",
      "info": "Four of these fill the panel so it is never empty." },
    { "type": "text", "id": "terms", "label": "Popular searches",
      "default": "Heavyweight tees, Tank tops, Cargo pants, The Renaissance Tee, Everything in black",
      "info": "Separate with commas." },
    { "type": "link_list", "id": "jump_menu", "label": "Jump to menu" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Menu column",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Links" },
        { "type": "text", "id": "heading_2", "label": "Second heading" },
        { "type": "link_list", "id": "menu_2", "label": "Second set of links" }
      ]
    },
    {
      "type": "featured",
      "name": "Featured product",
      "limit": 2,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "tag", "label": "Label", "default": "Best seller" }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
