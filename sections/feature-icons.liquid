{% render 'section-style', s: section %}
<section class="sec-pad">
  <div class="wrap">
    {%- if section.settings.heading != blank -%}
      <div class="sec-head"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    {%- endif -%}
    <div class="feat" data-row data-max="{{ section.blocks.size | at_most: 4 }}">
      {%- for block in section.blocks -%}
        <div class="feat-i" {{ block.shopify_attributes }}>
          <div class="feat-ico">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M2 8h11v8H2zM13 11h4l3 3v2h-7z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
              {%- when 'return' -%}<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 109-9"/><path d="M3 4v5h5"/></svg>
              {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>
              {%- when 'ruler' -%}<svg viewBox="0 0 24 24"><path d="M3 8h18v8H3zM7 8v4M11 8v6M15 8v4M19 8v6"/></svg>
              {%- when 'stitch' -%}<svg viewBox="0 0 24 24"><path d="M3 12h3l2-4 3 8 3-8 2 4h5"/></svg>
              {%- when 'pin' -%}<svg viewBox="0 0 24 24"><path d="M12 21s7-6 7-11a7 7 0 10-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5l3 2"/></svg>
            {%- endcase -%}
          </div>
          <h4>{{ block.settings.title }}</h4>
          {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Feature row",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "header", "content": "Appearance" },
    { "type": "select", "id": "scheme", "label": "Background", "default": "alt",
      "options": [{"value":"light","label":"White"},{"value":"alt","label":"Off-white"},
                  {"value":"sand","label":"Sand"},{"value":"dark","label":"Dark"},{"value":"custom","label":"Custom"}] },
    { "type": "color", "id": "bg_custom", "label": "Custom background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_custom", "label": "Custom text", "default": "#111111" },
    { "type": "range", "id": "pad_top", "label": "Extra top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "pad_bottom", "label": "Extra bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "feature", "name": "Feature", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck",
        "options": [{"value":"truck","label":"Shipping"},{"value":"return","label":"Returns"},
                    {"value":"shield","label":"Secure"},{"value":"ruler","label":"Sizing"},
                    {"value":"stitch","label":"Craft"},{"value":"pin","label":"Local"}] },
      { "type": "text", "id": "title", "label": "Title", "default": "Free shipping over $100" },
      { "type": "text", "id": "body", "label": "Body", "default": "Standard shipping within the contiguous US." }
    ]}
  ],
  "presets": [{ "name": "Feature row", "blocks": [{"type":"feature"},{"type":"feature"},{"type":"feature"}] }]
}
{% endschema %}
