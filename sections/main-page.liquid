{%- comment -%} A plain page — the document layout, driven by the page's own content. {%- endcomment -%}
<div class="doc-hd">
  <div class="wrap">
    {%- if section.settings.eyebrow != blank -%}<div class="lab">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ page.title }}</h1>
  </div>
</div>
<div class="wrap doc doc--single">
  <div class="doc-body"><section>{{ page.content }}</section></div>
</div>
{% schema %}
{
  "name": "Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" }
  ]
}
{% endschema %}
