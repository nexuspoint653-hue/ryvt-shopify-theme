<div class="f-split">
  {%- for block in section.blocks -%}
    <a class="f-panel" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <img src="{{ block.settings.image | image_url: width: 1600 }}" alt="" loading="lazy">
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      <div class="c">
        <h3>{{ block.settings.title }}</h3>
        {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
      </div>
    </a>
  {%- endfor -%}
</div>
{% schema %}
{
  "name": "Editorial split",
  "max_blocks": 2,
  "blocks": [
    { "type": "panel", "name": "Panel", "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "title", "label": "Title", "default": "Discover RYVT" },
      { "type": "textarea", "id": "body", "label": "Body" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Editorial split", "blocks": [{ "type": "panel" }, { "type": "panel" }] }]
}
{% endschema %}
