{%- comment -%}
  First-visit offer.

  The class names are deliberately prefixed: the theme already has a `.ck`
  cookie dialog in the footer and a `.promo` bar on the landing film, and an
  earlier version of this section reused both names, so it inherited their
  styling and rendered as a giant circle over the page.

  The cookie notice that used to live here is gone — the footer's Cookie
  preferences dialog does that job properly, with real toggles.
{%- endcomment -%}
{%- if section.settings.promo_on -%}
  <div class="offer" id="ryvtOffer" role="dialog" aria-modal="true" aria-labelledby="offerTitle" hidden>
    <div class="offer-veil" data-offer-close></div>
    <div class="offer-box">
      <button type="button" class="offer-x" data-offer-close aria-label="Close">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      {%- if section.settings.promo_image != blank -%}
        <div class="offer-art">
          <img src="{{ section.settings.promo_image | image_url: width: 900 }}"
               alt="" width="900" height="1100" loading="lazy">
        </div>
      {%- endif -%}
      <div class="offer-in">
        {%- if section.settings.promo_eyebrow != blank -%}
          <div class="offer-eyebrow">{{ section.settings.promo_eyebrow }}</div>
        {%- endif -%}
        <h2 class="offer-t" id="offerTitle">{{ section.settings.promo_title }}</h2>
        {%- if section.settings.promo_body != blank -%}
          <p class="offer-b">{{ section.settings.promo_body }}</p>
        {%- endif -%}
        {%- form 'customer', class: 'offer-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          <label class="sr" for="offerEmail">Email address</label>
          <input id="offerEmail" type="email" name="contact[email]"
                 placeholder="{{ section.settings.promo_placeholder }}" required>
          <button type="submit">{{ section.settings.promo_button }}</button>
          {%- if form.posted_successfully? -%}
            <p class="offer-ok">Check your inbox — your code is on the way.</p>
          {%- endif -%}
        {%- endform -%}
        <button type="button" class="offer-no" data-offer-close>{{ section.settings.promo_decline }}</button>
        {%- if section.settings.promo_fine != blank -%}
          <p class="offer-fine">{{ section.settings.promo_fine }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <style>
    .offer{position:fixed;inset:0;z-index:130;display:none;place-items:center;padding:20px}
    .offer.on{display:grid}
    .offer-veil{position:absolute;inset:0;background:rgba(8,8,10,.6);backdrop-filter:blur(5px);
      opacity:0;transition:opacity .35s var(--e)}
    .offer.on .offer-veil{opacity:1}
    .offer-box{position:relative;display:grid;grid-template-columns:1fr 1fr;
      width:min(880px,100%);max-height:88vh;overflow:hidden;background:var(--paper);
      color:var(--ink);border-radius:4px;box-shadow:0 40px 90px rgba(0,0,0,.4);
      opacity:0;transform:translateY(14px);transition:opacity .4s var(--e),transform .45s var(--e)}
    .offer.on .offer-box{opacity:1;transform:none}
    .offer-art{overflow:hidden;background:var(--plate)}
    .offer-art img{width:100%;height:100%;object-fit:cover;display:block}
    .offer-in{padding:44px 40px;display:flex;flex-direction:column;justify-content:center;gap:14px}
    .offer-eyebrow{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);font-weight:600}
    .offer-t{font-size:clamp(24px,3vw,34px);font-weight:800;letter-spacing:-.03em;line-height:1.05;margin:0}
    .offer-b{font-size:13.5px;line-height:1.65;color:var(--muted);margin:0}
    .offer-form{display:flex;flex-direction:column;gap:10px;margin-top:6px}
    .offer-form input{border:1px solid var(--line);padding:14px 16px;font:inherit;font-size:14px;
      background:var(--paper);color:var(--ink)}
    .offer-form input:focus{outline:0;border-color:var(--ink)}
    .offer-form button{background:var(--ink);color:var(--paper);border:0;padding:15px;
      font-size:11px;letter-spacing:.18em;text-transform:uppercase;font-weight:700;cursor:pointer}
    .offer-form button:hover{opacity:.86}
    .offer-no{background:none;border:0;padding:4px;font:inherit;font-size:12px;color:var(--muted);
      text-decoration:underline;text-underline-offset:3px;cursor:pointer}
    .offer-no:hover{color:var(--ink)}
    .offer-fine{font-size:11px;color:var(--muted);margin:0;line-height:1.6}
    .offer-ok{font-size:12.5px;color:var(--ink);margin:0}
    .offer-x{position:absolute;top:14px;right:14px;z-index:2;width:32px;height:32px;display:grid;
      place-items:center;background:var(--paper);border:1px solid var(--line);border-radius:50%;
      color:var(--ink);cursor:pointer}
    .offer-x:hover{background:var(--ink);color:var(--paper);border-color:var(--ink)}
    .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
    @media(max-width:760px){
      .offer-box{grid-template-columns:1fr}
      .offer-art{display:none}
      .offer-in{padding:34px 24px}
    }
  </style>

  <script>
  (function(){
    var box = document.getElementById('ryvtOffer');
    if(!box) return;
    function got(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
    function put(k,v){ try { localStorage.setItem(k,v); } catch(e){} }
    if(got('ryvt-offer')) return;
    setTimeout(function(){
      box.hidden = false;
      requestAnimationFrame(function(){ box.classList.add('on'); });
    }, {{ section.settings.promo_delay | default: 6 | times: 1000 }});
    function close(){
      box.classList.remove('on');
      put('ryvt-offer', 'dismissed');
      setTimeout(function(){ box.hidden = true; }, 420);
    }
    Array.prototype.forEach.call(box.querySelectorAll('[data-offer-close]'), function(b){
      b.addEventListener('click', close);
    });
    addEventListener('keydown', function(e){ if(e.key === 'Escape' && box.classList.contains('on')) close(); });
  })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Popups",
  "settings": [
    { "type": "paragraph", "content": "The cookie dialog lives in the footer now — this is just the first-visit offer." },
    { "type": "checkbox", "id": "promo_on", "label": "Show the offer", "default": false },
    { "type": "image_picker", "id": "promo_image", "label": "Photograph" },
    { "type": "text", "id": "promo_eyebrow", "label": "Eyebrow", "default": "First order" },
    { "type": "text", "id": "promo_title", "label": "Heading", "default": "15% off your first order" },
    { "type": "textarea", "id": "promo_body", "label": "Body",
      "default": "Join the list for first look at every drop. One email a fortnight, no more." },
    { "type": "text", "id": "promo_placeholder", "label": "Field placeholder", "default": "Email address" },
    { "type": "text", "id": "promo_button", "label": "Button", "default": "Get my 15%" },
    { "type": "text", "id": "promo_decline", "label": "Decline link", "default": "No thanks, I'll pay full price" },
    { "type": "textarea", "id": "promo_fine", "label": "Small print",
      "default": "One use per customer. Full-price items only." },
    { "type": "range", "id": "promo_delay", "label": "Seconds before it appears",
      "min": 0, "max": 30, "step": 1, "default": 6 }
  ]
}
{% endschema %}
