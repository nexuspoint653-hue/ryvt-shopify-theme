{%- comment -%} 404 — the site's treatment. {%- endcomment -%}
<section class="nf wrap">
  <div class="lab">Error 404</div>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.body }}</p>
  <div class="cta-row">
    <a class="btn btn-solid" href="{{ routes.all_products_collection_url }}">Shop the drop</a>
    <a class="btn" href="{{ routes.root_url }}">Back to the front</a>
  </div>
</section>
<style>
  .nf{padding-block:clamp(80px,14vh,180px);text-align:center;max-width:640px}
  .nf h1{font-size:clamp(34px,5vw,58px);font-weight:800;letter-spacing:-.035em;margin:14px 0 0}
  .nf p{color:var(--muted);font-size:15px;margin-top:14px}
  .nf .cta-row{justify-content:center;margin-top:30px}
</style>
{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page not found" },
    { "type": "textarea", "id": "body", "label": "Body",
      "default": "The link is dead, but the run is not. Start from the collection, or ask us where it went." }
  ]
}
{% endschema %}
