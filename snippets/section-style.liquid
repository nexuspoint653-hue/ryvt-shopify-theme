{%- comment -%}
  Per-section colour scheme. Every section calls this to emit scoped CSS vars,
  so background and text colour are editable in the theme editor.
  Usage: {% render 'section-style', s: section %}
{%- endcomment -%}
{%- liquid
  assign scheme = s.settings.scheme | default: 'light'
  assign pt = s.settings.pad_top | default: 0
  assign pb = s.settings.pad_bottom | default: 0
-%}
{%- case scheme -%}
  {%- when 'light'  -%}{%- assign bg = '#FFFFFF' -%}{%- assign fg = '#111111' -%}{%- assign mut = '#6B6B6B' -%}{%- assign ln = '#E6E6E3' -%}{%- assign glw = 'rgba(17,17,17,.42)' -%}
  {%- when 'alt'    -%}{%- assign bg = '#F7F7F6' -%}{%- assign fg = '#111111' -%}{%- assign mut = '#6B6B6B' -%}{%- assign ln = '#E2E2DF' -%}{%- assign glw = 'rgba(17,17,17,.40)' -%}
  {%- when 'sand'   -%}{%- assign bg = '#EFEAE2' -%}{%- assign fg = '#1A1A18' -%}{%- assign mut = '#6E6A62' -%}{%- assign ln = '#DCD5C9' -%}{%- assign glw = 'rgba(26,26,24,.38)' -%}
  {%- when 'dark'   -%}{%- assign bg = '#111111' -%}{%- assign fg = '#F5F5F3' -%}{%- assign mut = '#A0A0A0' -%}{%- assign ln = '#2C2C2C' -%}{%- assign glw = 'rgba(255,255,255,.30)' -%}
  {%- when 'custom' -%}
    {%- assign bg = s.settings.bg_custom | default: '#FFFFFF' -%}
    {%- assign fg = s.settings.text_custom | default: '#111111' -%}
    {%- assign mut = fg -%}{%- assign ln = fg -%}{%- assign glw = 'rgba(17,17,17,.35)' -%}
{%- endcase -%}
{%- comment -%}
  Optional per-section type overrides. Left empty they inherit the theme's
  typography, so a merchant only touches these when one section needs to differ.
{%- endcomment -%}
{%- liquid
  assign sec_font = s.settings.heading_font
  assign sec_size = s.settings.heading_size | default: 100
  assign sec_head_color = s.settings.heading_color
  assign sec_align = s.settings.text_align
-%}
{%- if sec_font -%}<style>{{ sec_font | font_face: font_display: 'swap' }}</style>{%- endif -%}
<style>
  #shopify-section-{{ s.id }}{
    --sec-bg:{{ bg }}; --sec-fg:{{ fg }}; --sec-muted:{{ mut }}; --sec-line:{{ ln }};
    --glow:{{ glw | default: 'rgba(17,17,17,.42)' }};
    background:var(--sec-bg); color:var(--sec-fg);
    {% if pt > 0 %}padding-top:{{ pt }}px;{% endif %}
    {% if pb > 0 %}padding-bottom:{{ pb }}px;{% endif %}
  }
  #shopify-section-{{ s.id }} .mini,
  #shopify-section-{{ s.id }} .crumb,
  #shopify-section-{{ s.id }} .pc-c{ color:var(--sec-muted) }
  #shopify-section-{{ s.id }} .btn{ border-color:var(--sec-fg); color:var(--sec-fg) }
  #shopify-section-{{ s.id }} .btn:hover{ background:var(--sec-fg); color:var(--sec-bg) }
  #shopify-section-{{ s.id }} .btn-solid{ background:var(--sec-fg); color:var(--sec-bg) }
  #shopify-section-{{ s.id }} .btn-solid:hover{ background:transparent; color:var(--sec-fg) }
  {%- if scheme == 'custom' -%}
  #shopify-section-{{ s.id }} .mini,#shopify-section-{{ s.id }} .crumb{ opacity:.7 }
  {%- endif -%}

  {%- if sec_font -%}
  #shopify-section-{{ s.id }} .h1,
  #shopify-section-{{ s.id }} .h2,
  #shopify-section-{{ s.id }} .h3{ font-family:{{ sec_font.family }}, {{ sec_font.fallback_families }} }
  {%- endif -%}
  {%- if sec_size != 100 -%}
  #shopify-section-{{ s.id }} .h1,
  #shopify-section-{{ s.id }} .h2,
  #shopify-section-{{ s.id }} .h3{ font-size:calc(1em * {{ sec_size | divided_by: 100.0 }}) }
  #shopify-section-{{ s.id }} .h1{ font-size:calc(clamp(32px,5vw,60px) * {{ sec_size | divided_by: 100.0 }}) }
  #shopify-section-{{ s.id }} .h2{ font-size:calc(clamp(24px,3vw,40px) * {{ sec_size | divided_by: 100.0 }}) }
  #shopify-section-{{ s.id }} .h3{ font-size:calc(clamp(16px,1.6vw,20px) * {{ sec_size | divided_by: 100.0 }}) }
  {%- endif -%}
  {%- if sec_head_color != blank -%}
  #shopify-section-{{ s.id }} .h1,
  #shopify-section-{{ s.id }} .h2,
  #shopify-section-{{ s.id }} .h3{ color:{{ sec_head_color }} }
  {%- endif -%}
  {%- if sec_align != blank and sec_align != 'left' -%}
  #shopify-section-{{ s.id }}{ text-align:{{ sec_align }} }
  {%- endif -%}
</style>
