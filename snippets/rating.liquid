{%- comment -%}
  Star rating. Reads product.metafields.reviews.rating (the convention used by
  Shopify Product Reviews and Judge.me). Renders nothing if there are no reviews.
  Usage: {% render 'rating', product: product %}
{%- endcomment -%}
{%- assign r = product.metafields.reviews.rating.value -%}
{%- assign n = product.metafields.reviews.rating_count.value | default: 0 -%}
{%- if r -%}
  {%- assign score = r.rating | times: 1.0 -%}
  <span class="stars" aria-label="{{ score }} out of 5">
    {%- for i in (1..5) -%}
      {%- if i <= score -%}
        <svg viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.2l1.4-7L2 9.4l7-.8z"/></svg>
      {%- else -%}
        <svg class="off" viewBox="0 0 24 24"><path d="M12 2l3 6.6 7 .8-5.2 4.8 1.4 7L12 17.8 5.8 21.2l1.4-7L2 9.4l7-.8z"/></svg>
      {%- endif -%}
    {%- endfor -%}
  </span>
  <span class="rc">({{ n }})</span>
{%- endif -%}
