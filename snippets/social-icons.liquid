{%- comment -%}
  Brand social icons in their native marks and colours.
  Reads settings.social_facebook / social_instagram / social_tiktok.
{%- endcomment -%}
{%- assign uid = 'ig' | append: section.id | default: 'ig1' | handleize -%}
<div class="socials f-social">
  {%- if settings.social_facebook != blank -%}
