{%- comment -%}
  Brand social icons in their native marks and colours.
  Reads settings.social_facebook / social_instagram / social_tiktok.
{%- endcomment -%}
<div class="socials f-social">
  {%- if settings.social_facebook != blank -%}
    <a class="soc soc-fb" href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="RYVT on Facebook">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.09 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.68.24 2.68.24v2.96h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.09 24 18.1 24 12.07z"/></svg>
    </a>
  {%- endif -%}
  {%- if settings.social_instagram != blank -%}
    <a class="soc soc-ig" href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="RYVT on Instagram">
      <span class="soc-mask" aria-hidden="true"></span>
    </a>
  {%- endif -%}
  {%- if settings.social_tiktok != blank -%}
    <a class="soc soc-tt" href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="RYVT on TikTok">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path fill="#25F4EE" d="M9.2 9.4v-.95a7.4 7.4 0 00-1-.07A7.28 7.28 0 005.1 21.6a7.26 7.26 0 01-1.94-4.95A7.28 7.28 0 019.2 9.4z"/>
        <path fill="#25F4EE" d="M9.36 19.85a3.33 3.33 0 003.32-3.2V2.2h2.72a5.6 5.6 0 01-.1-1.03h-3.72v14.45a3.33 3.33 0 01-3.32 3.2 3.3 3.3 0 01-1.54-.38 3.32 3.32 0 002.64 1.41z"/>
        <path fill="#FE2C55" d="M19.53 6.6V5.7a5.44 5.44 0 01-2.99-.89 5.48 5.48 0 002.99 1.79z"/>
        <path fill="#FE2C55" d="M16.54 4.81a5.47 5.47 0 01-1.35-3.64h-1a5.5 5.5 0 002.35 3.64z"/>
        <path fill="#FE2C55" d="M8.2 12.32a3.33 3.33 0 00-1.54 6.27 3.31 3.31 0 01-.63-1.95 3.33 3.33 0 013.33-3.33c.34 0 .68.06 1 .16V9.45a7.4 7.4 0 00-1-.07h-.18v2.6a3.3 3.3 0 00-.98-.15z"/>
        <path fill="currentColor" d="M19.53 6.6v2.58a9.45 9.45 0 01-5.52-1.77v8.03a7.28 7.28 0 01-7.28 7.28 7.22 7.22 0 01-4.16-1.31 7.28 7.28 0 0012.44-5.13V8.25a9.45 9.45 0 005.53 1.77V6.71a5.6 5.6 0 01-1.01-.11z"/>
        <path fill="currentColor" d="M14.01 15.44V7.41a9.45 9.45 0 005.52 1.77V6.6a5.48 5.48 0 01-2.99-1.79 5.5 5.5 0 01-2.35-3.64h-2.72v14.45a3.33 3.33 0 01-6 1.97 3.33 3.33 0 011.55-6.27c.34 0 .67.06.98.16v-2.6a7.28 7.28 0 00-5.13 12.2 7.22 7.22 0 004.16 1.31 7.28 7.28 0 007.28-7.28z"/>
      </svg>
    </a>
  {%- endif -%}
</div>
